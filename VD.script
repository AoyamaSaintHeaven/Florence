Tabs.CustomizerTab:Slider({
	Title = "Outline Transparency",
	Desc  = "0% = solid  •  100% = invisible",
	Value = { Min = 0, Max = 100, Default = math.floor(CONFIG.OutlineTransparency * 100 + 0.5) },
	Callback = function(v)
		applyOutlineAlpha(v / 100)
	end,
})

--=========================  AUTO UI REFRESH & BOOT  =======================

task.spawn(function()
	while true do
		if autoScan then
			task.wait(CONFIG.ScanInterval * 2)
			fullScan()
			refreshResultsList()
		else
			task.wait(1)
		end
	end
end)

setStatus("Initial scan...", Yellow)
task.spawn(function()
	fullScan()
	refreshResultsList()
	if foundCount > 0 then
		setStatus(("FOUND %d  •  %s"):format(foundCount, os.date("%H:%M:%S")), Red)
	else
		setStatus("Watching workspace...", Grey)
	end
end)

print("[KillerostScanner] WindUI edition loaded")
