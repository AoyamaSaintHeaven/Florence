Tabs.PlayerTab:Slider({
	Title = "Outline Transparency",
	Desc  = "0% = solid  •  100% = invisible",
	Value = { Min = 0, Max = 100, Default = math.floor(CONFIG.OutlineTransparency * 100 + 0.5) },
	Callback = function(v)
		applyOutlineAlpha(v / 100)
	end,
})

--==========================================================================
--  BACKGROUND SCANNER & BOOT
--==========================================================================

-- Runs every 10 seconds in the background. 
-- Because of 'scannedScripts' cache, it skips everything it already checked, causing NO lag.
task.spawn(function()
	while true do
		task.wait(CONFIG.ScanInterval)
		fullScan()
	end
end)

-- Initial boot scan
task.spawn(function()
	task.wait(3) -- Give game 3 seconds to load character
	fullScan()
end)

print("[KillerostScanner] Optimized Edition loaded")
