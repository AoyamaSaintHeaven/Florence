local Tabs = {
	PlayerTab     = Window:Tab({
		Title = "Players",
		Icon  = "121572094465765",
	}),
	ScannerTab    = Window:Tab({
		Title = "Scanner",
		Icon  = "121572094465765",
	}),
	CustomizerTab = Window:Tab({
		Title = "ESP Customizer",
		Icon  = "121572094465765",
	}),
}

--=========================  PLAYER TAB  ===================================
Tabs.PlayerTab:Toggle({
	Title = "Noclip",
	Desc  = "Pass through the Walls",
	Value = false,
	Callback = function(state)
		-- functions
	end,
})

--=========================  SCANNER TAB  ==================================

-- Status paragraph (updates on scan)
local statusParagraph = Tabs.ScannerTab:Paragraph({
	Title = "Status",
	Desc  = "Idle...",
	Color = Grey,
	Image = "rbxassetid://121572094465765",
	ImageSize = 24,
	Locked = false,
})

local function setStatus(text, color)
	statusParagraph:SetDesc(text)
	if color then
		statusParagraph:SetColor(color)
	end
end

-- Result list shown as a paragraph that we refresh on each scan
local resultsParagraph = Tabs.ScannerTab:Paragraph({
	Title = "Detected",
	Desc  = "No matches yet.",
	Color = Red,
	Image = "rbxassetid://121572094465765",
	ImageSize = 24,
	Locked = false,
})

local function refreshResultsList()
	local names = {}
	for model, data in pairs(tracked) do
		local scriptName = data.scriptName or "?"
		table.insert(names, "• " .. model.Name .. "  (" .. scriptName .. ")")
	end

	if #names == 0 then
		resultsParagraph:SetDesc("No matches yet.")
	else
		resultsParagraph:SetDesc(table.concat(names, "\n"))
	end
end

-- ESP on/off
Tabs.ScannerTab:Toggle({
	Title = "ESP Highlight",
	Desc  = "Show highlight on flagged models",
	Value = true,
	Callback = function(state)
		setESPEnabled(state)
		setStatus(state and "ESP enabled" or "ESP disabled", state and Green or Grey)
	end,
})

-- Auto re-scan toggle
Tabs.ScannerTab:Toggle({
	Title = "Auto Rescan",
	Desc  = "Re-scan whenever Workspace changes",
	Value = true,
	Callback = function(state)
		autoScan = state
		setStatus(state and "Auto-scan enabled" or "Auto-scan paused", state and Green or Grey)
	end,
})

-- Manual rescan
Tabs.ScannerTab:Button({
	Title = "Rescan Now",
	Desc  = "Run a full scan immediately",
	Callback = function()
		setStatus("Manual scan...", Yellow)
		task.spawn(function()
			-- Wait for any ongoing scan to finish
			while scanning do task.wait(0.1) end
			
			local n = fullScan()
			refreshResultsList()
			
			if n > 0 then
				setStatus(("FOUND %d  •  %s"):format(n, os.date("%H:%M:%S")), Red)
			else
				setStatus("Scanning... nothing yet", Grey)
			end
		end)
	end,
})

-- Clear
Tabs.ScannerTab:Button({
	Title = "Clear Highlights",
	Desc  = "Remove all current ESP markers",
	Callback = function()
		clearESP()
		refreshResultsList()
		setStatus("Cleared", Grey)
	end,
})

--=========================  ESP CUSTOMIZER TAB  ===========================
-- Color + Alpha live in the SAME tab now

Tabs.CustomizerTab:Section({
	Title = "Color",
	TextXAlignment = "Left",
	TextSize = 17,
})

Tabs.CustomizerTab:Colorpicker({
	Title = "Highlight Color",
	Desc  = "Fill color for the ESP",
	Default = CONFIG.Fill,
	Transparency = 0,
	Callback = function(color)
		applyColor(color)
		setStatus("Color updated", Green)
	end,
})

Tabs.CustomizerTab:Button({
	Title = "Preset: Red",
	Callback = function()
		applyColor(Color3.fromRGB(255, 45, 45))
		setStatus("Color → Red", Green)
	end,
})

Tabs.CustomizerTab:Button({
	Title = "Preset: Green",
	Callback = function()
		applyColor(Color3.fromRGB(45, 220, 90))
		setStatus("Color → Green", Green)
	end,
})

Tabs.CustomizerTab:Button({
	Title = "Preset: Blue",
	Callback = function()
		applyColor(Color3.fromRGB(60, 130, 255))
		setStatus("Color → Blue", Green)
	end,
})

Tabs.CustomizerTab:Button({
	Title = "Preset: Pink",
	Callback = function()
		applyColor(Color3.fromRGB(255, 90, 200))
		setStatus("Color → Pink", Green)
	end,
})

Tabs.CustomizerTab:Section({
	Title = "Transparency",
	TextXAlignment = "Left",
	TextSize = 17,
})

Tabs.CustomizerTab:Slider({
	Title = "Fill Transparency",
	Desc  = "0% = solid  •  100% = invisible",
	Value = { Min = 0, Max = 100, Default = math.floor(CONFIG.FillTransparency * 100 + 0.5) },
	Callback = function(v)
		applyFillAlpha(v / 100)
	end,
})

Tabs.CustomizerTab:Slider({
	Title = "Outline Transparency",
	Desc  = "0% = solid  •  100% = invisible",
	Value = { Min = 0, Max = 100, Default = math.floor(CONFIG.OutlineTransparency * 100 + 0.5) },
	Callback = function(v)
		applyOutlineAlpha(v / 100)
	end,
})

--=========================  AUTO UI REFRESH & BOOT  =======================
-- Start the auto-scan loop and ensure the UI refreshes every cycle
task.spawn(function()
	while true do
		if autoScan then
			task.wait(next(tracked) == nil and CONFIG.ScanInterval or CONFIG.ScanInterval * 2)
			fullScan()
			refreshResultsList()  -- Keeps the "Detected" list in sync automatically
		else
			task.wait(0.5)
		end
	end
end)

setStatus("Initial scan...", Yellow)
task.spawn(function()
	fullScan()
	refreshResultsList()
	if foundCount > 0 then
		setStatus(("FOUND %d  •  %s"):format(foundCount, os.date("%H:%M:%S")), Red)
	else
		setStatus("Watching workspace...", Grey)
	end
end)

print("[KillerostScanner] WindUI edition loaded")
