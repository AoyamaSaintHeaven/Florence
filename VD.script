--==========================================================================
--  FORCED UI LAYOUT OVERRIDE (Bypassing WindUI's default layout)
--==========================================================================
task.spawn(function()
	while task.wait(0.2) do
		local gui = game:GetService("CoreGui"):FindFirstChild("WindUI") 
			or game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("WindUI")
		
		if gui then
			local topbar = gui:FindFirstChild("Topbar", true)
			if topbar then
				-- 1. Destroy the layout that forces everything to the left
				local layout = topbar:FindFirstChildOfClass("UIListLayout")
				if layout then layout:Destroy() end

				-- 2. Move Title and Icon to the TOP LEFT
				local icon = topbar:FindFirstChild("Icon", true)
				if icon then
					icon.AnchorPoint = Vector2.new(0, 0.5)
					icon.Position = UDim2.new(0, 15, 0.5, 0)
					if icon.Parent ~= topbar and not icon.Parent:IsA("ScreenGui") then
						icon.Parent.AnchorPoint = Vector2.new(0, 0.5)
						icon.Parent.Position = UDim2.new(0, 15, 0.5, 0)
					end
				end

				local title = topbar:FindFirstChild("Title", true)
				if title then
					title.AnchorPoint = Vector2.new(0, 0.5)
					title.Position = UDim2.new(0, 50, 0.5, 0)
					title.TextXAlignment = Enum.TextXAlignment.Left
					if title.Parent ~= topbar and not title.Parent:IsA("ScreenGui") then
						title.Parent.AnchorPoint = Vector2.new(0, 0.5)
						title.Parent.Position = UDim2.new(0, 50, 0.5, 0)
					end
				end

				-- 3. Move Mac Buttons to TOP RIGHT, Make Bigger, Add Distance
				for _, frame in pairs(topbar:GetDescendants()) do
					if frame:IsA("Frame") then
						local btnCount = 0
						for _, child in pairs(frame:GetChildren()) do
							if child:IsA("TextButton") or child:IsA("ImageButton") then
								btnCount = btnCount + 1
							end
						end
						
						-- If we found the frame with the 3 Mac buttons
						if btnCount == 3 then
							frame.AnchorPoint = Vector2.new(1, 0.5)
							frame.Position = UDim2.new(1, -15, 0.5, 0)
							
							local cLayout = frame:FindFirstChildOfClass("UIListLayout")
							if not cLayout then
								cLayout = Instance.new("UIListLayout")
								cLayout.Parent = frame
							end
							
							cLayout.FillDirection = Enum.FillDirection.Horizontal
							cLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
							cLayout.VerticalAlignment = Enum.VerticalAlignment.Center
							cLayout.Padding = UDim.new(0, 12) -- Distance between buttons
							
							for _, btn in pairs(frame:GetChildren()) do
								if btn:IsA("TextButton") or btn:IsA("ImageButton") then
									btn.Size = UDim2.fromOffset(22, 22) -- Bigger buttons
								end
							end
							break
						end
					end
				end
			end
		end
	end
end)

