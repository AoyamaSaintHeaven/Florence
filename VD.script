--=========================  SCANNER TAB  ==================================

local statusParagraph = Tabs.ScannerTab:Paragraph({
	Title = "Status",
	Desc  = "Idle...",
	Color = Grey,
	Image = "rbxassetid://121572094465765",
	ImageSize = 24,
	Locked = false,
})

local function setStatus(text, color)
	statusParagraph:SetDesc(text)
	if color then
		statusParagraph:SetColor(color)
	end
end

local resultsParagraph = Tabs.ScannerTab:Paragraph({
	Title = "Detected",
	Desc  = "No matches yet.",
	Color = Red,
	Image = "rbxassetid://121572094465765",
	ImageSize = 24,
	Locked = false,
})

local function refreshResultsList()
	local names = {}
	for model, data in pairs(tracked) do
		local scriptName = data.scriptName or "?"
		local prefix = (model == currentKillerModel) and "[KILLER] " or "• "
		table.insert(names, prefix .. model.Name .. "  (" .. scriptName .. ")")
	end

	if #names == 0 then
		resultsParagraph:SetDesc("No matches yet.")
	else
		resultsParagraph:SetDesc(table.concat(names, "\n"))
	end
end

Tabs.ScannerTab:Toggle({
	Title = "ESP Highlight",
	Desc  = "Show highlight on flagged models",
	Value = true,
	Callback = function(state)
		setESPEnabled(state)
		setStatus(state and "ESP enabled" or "ESP disabled", state and Green or Grey)
	end,
})

Tabs.ScannerTab:Toggle({
	Title = "Auto Rescan",
	Desc  = "Re-scan whenever Workspace changes",
	Value = true,
	Callback = function(state)
		autoScan = state
		setStatus(state and "Auto-scan enabled" or "Auto-scan paused", state and Green or Grey)
	end,
})

Tabs.ScannerTab:Button({
	Title = "Rescan Now",
	Desc  = "Run a full scan immediately",
	Callback = function()
		setStatus("Manual scan...", Yellow)
		task.spawn(function()
			while scanning do task.wait(0.1) end
			local n = fullScan()
			refreshResultsList()
			if n > 0 then
				setStatus(("FOUND %d  •  %s"):format(n, os.date("%H:%M:%S")), Red)
			else
				setStatus("Scanning... nothing yet", Grey)
			end
		end)
	end,
})

