-- */  Colors  /* --
local Purple = Color3.fromHex("#7775F2")
local Yellow = Color3.fromHex("#ECA201")
local Green = Color3.fromHex("#10C550")
local Grey = Color3.fromHex("#83889E")
local Blue = Color3.fromHex("#257AF7")
local Red = Color3.fromHex("#EF4F1D")

--==========================================================================
--  KILLEROST SCANNER  —  Optimized for Mobile + Killer Change Detection
--==========================================================================

local Players   = cloneref(game:GetService("Players"))
local Workspace = cloneref(game:GetService("Workspace"))

--=========================  CONFIG  =======================================
local CONFIG = {
	Keyword             = "killerost",
	ScanInterval        = 10,   
	Debounce            = 1.5,  
	Fill                = Color3.fromRGB(255, 45, 45),
	Outline             = Color3.fromRGB(255, 45, 45),
	FillTransparency    = 0.45,
	OutlineTransparency = 0,
}

--=========================  SCAN CORE  ====================================

local tracked    = {}
local knownKillerScripts = {} -- CACHE: Remembers scripts that match, even if moved
local autoScan   = true
local espEnabled = true
local currentKillerModel = nil -- Tracks the active killer

local function getScriptText(obj)
	local parts = { obj.Name, obj.Parent and obj.Parent.Name or "" }
	local ok, src = pcall(function() return obj.Source end)
	
	if ok and type(src) == "string" and src ~= "" then 
		parts[#parts + 1] = src 
	else
		if getscriptbytecode then
			local ok2, bc = pcall(getscriptbytecode, obj)
			if ok2 and type(bc) == "string" then parts[#parts + 1] = bc end
		end
		if getsenv then
			local ok3, env = pcall(getsenv, obj)
			if ok3 and type(env) == "table" then
				for k in pairs(env) do parts[#parts + 1] = tostring(k) end
			end
		end
	end
	return table.concat(parts, "\n")
end

local function isHumanoidModel(inst)
	return inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") ~= nil
end

local function scanModelForKeyword(model)
	if tracked[model] then return nil end
	
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			-- If we ALREADY know this is a killer script (e.g. game moved it), instantly flag it
			if knownKillerScripts[d] then
				return d
			end
			
			-- If it's a new script, scan it
			if not knownKillerScripts[d] then
				local text = getScriptText(d)
				if text ~= "" and string.find(string.lower(text), CONFIG.Keyword, 1, true) then
					knownKillerScripts[d] = true
					return d
				end
			end
		end
	end
	return nil
end

local function applyESP(model, scriptObj)
	if tracked[model] then return end

	local hl = Instance.new("Highlight")
	hl.Name                = "KillerostESP"
	hl.Adornee             = model
	hl.FillColor           = CONFIG.Fill
	hl.OutlineColor        = CONFIG.Outline
	hl.FillTransparency    = CONFIG.FillTransparency
	hl.OutlineTransparency = CONFIG.OutlineTransparency
	hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Enabled             = espEnabled
	hl.Parent              = model

	tracked[model] = { highlight = hl, scriptName = scriptObj.Name }

	-- DETECT KILLER CHANGE
	if currentKillerModel ~= model then
		currentKillerModel = model
		
		-- If the UI is ready, update the status and send a notification
		if Window then
			Window:Notify({
				Title = "Killer Detected!",
				Content = model.Name .. " is the Killer.",
				Icon = "rbxassetid://121572094465765",
				Duration = 5
			})
		end
	end
end

local function clearESP()
	for model, data in pairs(tracked) do
		if data.highlight then data.highlight:Destroy() end
		tracked[model] = nil
	end
end

local function setESPEnabled(state)
	espEnabled = state
	for _, data in pairs(tracked) do
		if data.highlight then data.highlight.Enabled = state end
	end
end

local function applyColor(color)
	CONFIG.Fill = color
	CONFIG.Outline = color
	for _, data in pairs(tracked) do
		if data.highlight then
			data.highlight.FillColor = color
			data.highlight.OutlineColor = color
		end
	end
end

local function applyFillAlpha(v)
	CONFIG.FillTransparency = v
	for _, data in pairs(tracked) do
		if data.highlight then data.highlight.FillTransparency = v end
	end
end

local function applyOutlineAlpha(v)
	CONFIG.OutlineTransparency = v
	for _, data in pairs(tracked) do
		if data.highlight then data.highlight.OutlineTransparency = v end
	end
end

--=========================  FULL SCAN  ====================================
local scanning = false
local foundCount = 0

local function fullScan()
	if scanning then return 0 end
	scanning = true

	local found = 0
	local count = 0
	local foundKillerModel = nil

	local ok, err = pcall(function()
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("Model") then
				count = count + 1
				if count % 50 == 0 then
					task.wait() -- Anti-lag frame yield
				end

				if isHumanoidModel(obj) then
					local hit = scanModelForKeyword(obj)
					if hit then
						found += 1
						applyESP(obj, hit)
						foundKillerModel = obj
					end
				end
			end
		end
	end)

	-- Check if the old killer is still valid
	local killerStillExists = false
	for model, data in pairs(tracked) do
		if not model.Parent or not model:FindFirstChildOfClass("Humanoid") then
			if data.highlight then data.highlight:Destroy() end
			tracked[model] = nil
			if model == currentKillerModel then
				currentKillerModel = nil -- Killer left or died
			end
		elseif model == currentKillerModel then
			killerStillExists = true
		end
	end

	-- If the killer was removed and we found a new one, trigger a change
	if not killerStillExists and foundKillerModel then
		currentKillerModel = foundKillerModel
	end

	foundCount = found

	if not ok then
		warn("[KillerostScanner] " .. tostring(err))
	end

	scanning = false
	return found
end

--=========================  AUTO RE-SCAN  =================================
local queued = false
local function queueRescan()
	if not autoScan or queued then return end
	queued = true
	task.delay(CONFIG.Debounce, function()
		queued = false
		if autoScan then fullScan() end
	end)
end

Workspace.DescendantAdded:Connect(function(inst)
	if inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript") or inst:IsA("Model") then
		queueRescan()
	end
end)
Workspace.DescendantRemoving:Connect(queueRescan)

