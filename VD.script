local AURA_STYLE_NAMES = {
    "Halo", "Rune Ring", "Flame", "Lightning", "Smoke", "Sonar Rings", "Orbiting Orbs",
    "Glitch", "Sparkles", "Aurora", "Blood Drip", "Matrix Rain", "Fireflies", "Frost",
    "Sunburst", "Embers", "Shadow", "Comet Trail", "Gravity Pull",
