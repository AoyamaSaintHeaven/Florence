--==========================================================================
--  AUTO GENERATOR  (Camera-Safe Mobile Fix)
--==========================================================================

local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer          = Players.LocalPlayer
local PlayerGui            = LocalPlayer:WaitForChild("PlayerGui")

local AUTO_GEN_CONFIG = {
	LOCK_OFFSET     = 105,
	SUBMIT_DELAY    = 0.15,
	STARTUP_GRACE   = 8.0,    
	CHECK_GRACE     = 0.15,   
	MOUSE_HOLD      = 0.05,   
}

local autoSubmitEnabled  = false
local isSkillCheckActive = false
local lastSubmitAttempt  = 0
local submitInProgress   = false
local skillCheckSeenAt   = 0
local gameReadyAt        = 0

local function autogenLog(message, isError)
	print((isError and "[ERROR] " or "[INFO] ") .. tostring(message))
end

local function isPlayerReady()
	local char = LocalPlayer.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	return char:FindFirstChild("HumanoidRootPart") ~= nil
end

task.spawn(function()
	while not isPlayerReady() do task.wait(0.25) end
	task.wait(1) 
	gameReadyAt = tick()
	autogenLog("Player ready. Auto Generator armed.")
end)

local function withinStartupGrace()
	if gameReadyAt == 0 then return true end
	return (tick() - gameReadyAt) < AUTO_GEN_CONFIG.STARTUP_GRACE
end

local function isRepairing()
	local progressGui = PlayerGui:FindFirstChild("ProgressPromptGui")
	if not progressGui then return false end

	local frame = progressGui:FindFirstChild("Frame")
	if frame and frame:IsA("GuiObject") and frame.Visible then return true end

	local oldFrame = progressGui:FindFirstChild("oldFrame")
	if oldFrame and oldFrame:IsA("GuiObject") and oldFrame.Visible then return true end

	return false
end

local function findActionButton()
	local survivorMob = PlayerGui:FindFirstChild("Survivor-mob")
	if not survivorMob then return nil end
	local controls = survivorMob:FindFirstChild("Controls")
	if not controls then return nil end
	return controls:FindFirstChild("action")
end

local function isActionButtonReady(button)
	if not button or not button:IsA("GuiButton") then return false end
	if not button.Visible or button.AbsoluteSize.X <= 0 then return false end
	return true
end

local function fireButtonViaConnections(button)
	if not button or not getconnections then return false end
	local fired = false
	for _, signalName in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down" }) do
		local signal = button[signalName]
		if signal then
			local ok, connections = pcall(getconnections, signal)
			if ok and connections then
				for _, connection in ipairs(connections) do
					if connection.Enabled then
						if pcall(function() connection:Fire() end) then
							fired = true
						end
					end
				end
			end
		end
	end
	return fired
end

local function fireButtonViaMouse(button)
	if not button or not VirtualInputManager then return false end
	local pos, size = button.AbsolutePosition, button.AbsoluteSize
	local cx = pos.X + size.X / 2
	local cy = pos.Y + size.Y / 2

	local ok = pcall(function()
		VirtualInputManager:SendMouseButtonEvent(cx, cy, 1, true, workspace, 1)
		task.wait(AUTO_GEN_CONFIG.MOUSE_HOLD)
		VirtualInputManager:SendMouseButtonEvent(cx, cy, 1, false, workspace, 1)
	end)

	if ok then
		autogenLog("Sent safe mouse click.")
		return true
	end
	return false
end

local function attemptSubmit()
	local now = tick()
	if now - lastSubmitAttempt < AUTO_GEN_CONFIG.SUBMIT_DELAY then return end
	if withinStartupGrace() or not isPlayerReady() or not isRepairing() then return end

	local button = findActionButton()
	if not isActionButtonReady(button) then return end

	lastSubmitAttempt = now
	if not fireButtonViaConnections(button) then
		fireButtonViaMouse(button)
	end
end

local function getSkillCheckParts()
	local gui = PlayerGui:FindFirstChild("SkillCheckPromptGui")
		or PlayerGui:FindFirstChild("SkillCheckPromptGui-con")
	if not gui or not gui.Enabled then return nil end
	if gui:IsA("GuiObject") and not gui.Visible then return nil end

	local check = gui:FindFirstChild("Check")
	if not check then return nil end

	local line = check:FindFirstChild("Line")
	local goal = check:FindFirstChild("Goal")
	if not (line and goal) then return nil end
	if not (line:IsA("GuiObject") and goal:IsA("GuiObject")) then return nil end
	if goal.AbsoluteSize.X <= 0 or goal.AbsoluteSize.Y <= 0 then return nil end

	return line, goal
end

RunService.RenderStepped:Connect(function()
	if not isPlayerReady() then
		isSkillCheckActive = false
		submitInProgress   = false
		skillCheckSeenAt   = 0
		return
	end

	local line, goal = getSkillCheckParts()

	if line and goal then
		if skillCheckSeenAt == 0 then
			skillCheckSeenAt = tick()
		end
		
		if tick() - skillCheckSeenAt >= AUTO_GEN_CONFIG.CHECK_GRACE then
			if isRepairing() then
				local target = goal.Rotation + AUTO_GEN_CONFIG.LOCK_OFFSET
				if line.Rotation ~= target then
					line.Rotation = target
				end
			end

			if not isSkillCheckActive then
				isSkillCheckActive = true
				autogenLog("Skill-check detected. Arrow lock armed.")
			end

			if autoSubmitEnabled and not submitInProgress and not withinStartupGrace() and isRepairing() then
				local button = findActionButton()
				if isActionButtonReady(button) then
					submitInProgress = true
					task.spawn(function()
						task.wait(AUTO_GEN_CONFIG.SUBMIT_DELAY)
						attemptSubmit()
						task.wait(AUTO_GEN_CONFIG.SUBMIT_DELAY)
						submitInProgress = false
					end)
				end
			end
		end
	else
		if isSkillCheckActive then
			isSkillCheckActive = false
			autogenLog("Skill-check ended.")
		end
		submitInProgress = false
		skillCheckSeenAt = 0
	end
end)

Tabs.MainTab:Toggle({
	Title = "Auto Generator",
	Desc  = "Auto-locks the skill-check arrow and auto-submits when repairing",
	Value = false,
	Callback = function(state)
		autoSubmitEnabled = state
		autogenLog("Auto Generator " .. (state and "ENABLED" or "DISABLED") .. ".")
	end,
})

Tabs.MainTab:Button({
	Title = "Fix Camera",
	Desc  = "Manually unfreeze the camera if it ever gets stuck",
	Callback = function()
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local cam = workspace.CurrentCamera
		pcall(function() cam.CameraType = Enum.CameraType.Custom end)
		if hum then
			pcall(function() cam.CameraSubject = hum end)
		end
		task.wait(0.1)
		if hum then
			pcall(function() cam.CameraSubject = hum end)
		end
		autogenLog("Camera reset requested.")
	end,
})

--==========================================================================
--  PLAYERS TAB (Scanner + ESP Customizer merged)
--==========================================================================

local statusParagraph = Tabs.PlayerTab:Paragraph({
	Title = "Scanner Status",
	Desc  = "Scanning (Optimized)...",
	Color = Green,
	Image = "rbxassetid://121572094465765",
	ImageSize = 24,
	Locked = false,
})

local function setStatus(text, color)
	statusParagraph:SetDesc(text)
	if color then
		statusParagraph:SetColor(color)
	end
end

local resultsParagraph = Tabs.PlayerTab:Paragraph({
	Title = "Detected",
	Desc  = "No matches yet.",
	Color = Red,
	Image = "rbxassetid://121572094465765",
	ImageSize = 24,
	Locked = false,
})

-- Link the forward declaration to the actual function
function refreshResultsList()
	local names = {}
	for model, data in pairs(tracked) do
		local scriptName = data.scriptName or "?"
		local prefix = (model == currentKillerModel) and "[KILLER] " or "• "
		table.insert(names, prefix .. model.Name .. "  (" .. scriptName .. ")")
	end

	if #names == 0 then
		resultsParagraph:SetDesc("No matches yet.")
	else
		resultsParagraph:SetDesc(table.concat(names, "\n"))
	end
end

Tabs.PlayerTab:Toggle({
	Title = "ESP Highlight",
	Desc  = "Show highlight on flagged models",
	Value = true,
	Callback = function(state)
		setESPEnabled(state)
		setStatus(state and "ESP enabled" or "ESP disabled", state and Green or Grey)
	end,
})

Tabs.PlayerTab:Button({
	Title = "Rescan Now",
	Desc  = "Run a full scan immediately",
	Callback = function()
		setStatus("Manual scan...", Yellow)
		task.spawn(function()
			local n = fullScan()
			if n > 0 then
				setStatus(("FOUND %d  •  %s"):format(n, os.date("%H:%M:%S")), Red)
			else
				setStatus("Scanning... nothing yet", Grey)
			end
		end)
	end,
})

