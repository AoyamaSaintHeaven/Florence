-- */  Colors  /* --
local Purple = Color3.fromHex("#7775F2")
local Yellow = Color3.fromHex("#ECA201")
local Green = Color3.fromHex("#10C550")
local Grey = Color3.fromHex("#83889E")
local Blue = Color3.fromHex("#257AF7")
local Red = Color3.fromHex("#EF4F1D")

-- */ Other Functions /* --
local function parseJSON(luau_table, indent, level, visited)
	indent = indent or 2
	level = level or 0
	visited = visited or {}

	local currentIndent = string.rep(" ", level * indent)
	local nextIndent = string.rep(" ", (level + 1) * indent)

	if luau_table == nil then
		return "null"
	end

	local dataType = type(luau_table)

	if dataType == "table" then
		if visited[luau_table] then
			return '"[Circular Reference]"'
		end

		visited[luau_table] = true

		local isArray = true
		local maxIndex = 0

		for k, _ in pairs(luau_table) do
			if type(k) == "number" and k > maxIndex then
				maxIndex = k
			end
			if type(k) ~= "number" or k <= 0 or math.floor(k) ~= k then
				isArray = false
				break
			end
		end

		local count = 0
		for _ in pairs(luau_table) do
			count = count + 1
		end
		if count ~= maxIndex and isArray then
			isArray = false
		end

		if count == 0 then
			return "{}"
		end

		if isArray then
			if count == 0 then
				return "[]"
			end

			local result = "[\n"

			for i = 1, maxIndex do
				result = result .. nextIndent .. parseJSON(luau_table[i], indent, level + 1, visited)
				if i < maxIndex then
					result = result .. ","
				end
				result = result .. "\n"
			end

			result = result .. currentIndent .. "]"
			return result
		else
			local result = "{\n"
			local first = true

			local keys = {}
			for k in pairs(luau_table) do
				table.insert(keys, k)
			end
			table.sort(keys, function(a, b)
				if type(a) == type(b) then
					return tostring(a) < tostring(b)
				else
					return type(a) < type(b)
				end
			end)

			for _, k in ipairs(keys) do
				local v = luau_table[k]
				if not first then
					result = result .. ",\n"
				else
					first = false
				end

				if type(k) == "string" then
					result = result .. nextIndent .. '"' .. k .. '": '
				else
					result = result .. nextIndent .. '"' .. tostring(k) .. '": '
				end

				result = result .. parseJSON(v, indent, level + 1, visited)
			end

			result = result .. "\n" .. currentIndent .. "}"
			return result
		end
	elseif dataType == "string" then
		local escaped = luau_table:gsub("\\", "\\\\")
		escaped = escaped:gsub('"', '\\"')
		escaped = escaped:gsub("\n", "\\n")
		escaped = escaped:gsub("\r", "\\r")
		escaped = escaped:gsub("\t", "\\t")

		return '"' .. escaped .. '"'
	elseif dataType == "number" then
		return tostring(luau_table)
	elseif dataType == "boolean" then
		return luau_table and "true" or "false"
	elseif dataType == "function" then
		return '"function"'
	else
		return '"' .. dataType .. '"'
	end
end

local function tableToClipboard(luau_table, indent)
	indent = indent or 4
	local jsonString = parseJSON(luau_table, indent)
	setclipboard(jsonString)
	return jsonString
end

--==========================================================================
--  KILLEROST SCANNER  —  integrated with WindUI
--==========================================================================

local Players   = cloneref(game:GetService("Players"))
local Workspace = cloneref(game:GetService("Workspace"))

--=========================  CONFIG  =======================================
local CONFIG = {
	Keyword             = "killerost",
	ScanInterval        = 3,
	Debounce            = 0.6,
	Fill                = Color3.fromRGB(255, 45, 45),
	Outline             = Color3.fromRGB(255, 255, 255),
	FillTransparency    = 0.45,
	OutlineTransparency = 0,
}

--=========================  SCAN CORE  ====================================

local tracked    = {}     -- [model] = { highlight, scriptName }
local autoScan   = true
local espEnabled = true

local function getScriptText(obj)
	local parts = { obj.Name, obj.Parent and obj.Parent.Name or "" }
	local ok, src = pcall(function() return obj.Source end)
	if ok and type(src) == "string" then parts[#parts + 1] = src end
	if getscriptbytecode then
		local ok2, bc = pcall(getscriptbytecode, obj)
		if ok2 and type(bc) == "string" then parts[#parts + 1] = bc end
	end
	if getsenv then
		local ok3, env = pcall(getsenv, obj)
		if ok3 and type(env) == "table" then
			for k in pairs(env) do parts[#parts + 1] = tostring(k) end
		end
	end
	return table.concat(parts, "\n")
end

local function isHumanoidModel(inst)
	return inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") ~= nil
end

local function scanModelForKeyword(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			local text = getScriptText(d)
			if text ~= "" and string.find(string.lower(text), CONFIG.Keyword, 1, true) then
				return d
			end
		end
	end
	return nil
end

local function applyESP(model, scriptObj)
	if tracked[model] then return end

	local hl = Instance.new("Highlight")
	hl.Name                = "KillerostESP"
	hl.Adornee             = model
	hl.FillColor           = CONFIG.Fill
	hl.OutlineColor        = CONFIG.Outline
	hl.FillTransparency    = CONFIG.FillTransparency
	hl.OutlineTransparency = CONFIG.OutlineTransparency
	hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Enabled             = espEnabled
	hl.Parent              = model

	-- BillboardGui tag logic completely removed

	tracked[model] = { highlight = hl, scriptName = scriptObj.Name }
end

local function clearESP()
	for model, data in pairs(tracked) do
		if data.highlight then data.highlight:Destroy() end
		tracked[model] = nil
	end
end

local function setESPEnabled(state)
	espEnabled = state
	for _, data in pairs(tracked) do
		if data.highlight then data.highlight.Enabled = state end
	end
end

local function applyColor(color)
	CONFIG.Fill = color
	for _, data in pairs(tracked) do
		if data.highlight then data.highlight.FillColor = color end
	end
end

local function applyFillAlpha(v)
	CONFIG.FillTransparency = v
	for _, data in pairs(tracked) do
		if data.highlight then data.highlight.FillTransparency = v end
	end
end

local function applyOutlineAlpha(v)
	CONFIG.OutlineTransparency = v
	for _, data in pairs(tracked) do
		if data.highlight then data.highlight.OutlineTransparency = v end
	end
end

--=========================  FULL SCAN  ====================================
local scanning = false
local foundCount = 0

local function fullScan()
	if scanning then return 0 end
	scanning = true

	local found = 0

	local ok, err = pcall(function()
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if isHumanoidModel(obj) then
				local hit = scanModelForKeyword(obj)
				if hit then
					found += 1
					applyESP(obj, hit)
				end
			end
		end
	end)

	for model, data in pairs(tracked) do
		if not model.Parent or not model:FindFirstChildOfClass("Humanoid") then
			if data.highlight then data.highlight:Destroy() end
			tracked[model] = nil
		end
	end

	foundCount = found

	if not ok then
		warn("[KillerostScanner] " .. tostring(err))
	end

	scanning = false
	return found
end

--=========================  AUTO RE-SCAN  =================================
local queued = false
local function queueRescan()
	if not autoScan or queued then return end
	queued = true
	task.delay(CONFIG.Debounce, function()
		queued = false
		if autoScan then fullScan() end
	end)
end

Workspace.DescendantAdded:Connect(function(inst)
	if inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript")
	or inst:IsA("Model") or inst:IsA("Humanoid") or inst:IsA("BasePart") then
		queueRescan()
	end
end)
Workspace.DescendantRemoving:Connect(queueRescan)
Workspace.ChildAdded:Connect(queueRescan)

