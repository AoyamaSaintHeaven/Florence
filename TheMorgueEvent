	.. FIRE_COOLDOWN .. "s). If the item doesn't disappear within "
	.. VANISH_TIMEOUT .. "s, it gives up and moves to the next one.")

task.spawn(function()
	while gui.Parent do
		if claimState.enabled then
			local suffix = claimState.isTweening and "  •  dropping in…" or ""
			if claimState.itemsSeen > 0 then
				claimStatusLbl.Text = "● Claiming…" .. suffix
				claimStatusLbl.TextColor3 = P.Accent
			else
				claimStatusLbl.Text = "● Scanning…  waiting for items"
				claimStatusLbl.TextColor3 = P.Good
			end
		else
			claimStatusLbl.Text = "Idle."
			claimStatusLbl.TextColor3 = P.Sub
		end
		claimCurrentLbl.Text = "Target: " .. claimState.currentName
