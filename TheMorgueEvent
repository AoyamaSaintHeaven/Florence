local patrolPage = makeTab("patrol", "👁", "Patrol ESP")

local PATROL_PATH    = workspace:FindFirstChild("Patrol")
local SCAN_INTERVAL  = 0.25
local ESP_FILL       = Color3.fromRGB(255,  80,  80)
local ESP_OUTLINE    = Color3.fromRGB(180,  30,  30)
local ESP_LABEL_Y    = 3

local patrolState = {
	enabled     = false,
	loopRunning = false,
	esp         = {},
}

local removeESP

local function addESP(model)
	if not model or not model.Parent then return end
	if patrolState.esp[model] then return end

	local entry = { conns = {} }

	local hl = Instance.new("Highlight")
	hl.Name                = "PatrolESP"
	hl.FillColor           = ESP_FILL
	hl.OutlineColor        = ESP_OUTLINE
	hl.FillTransparency    = 0.5
	hl.OutlineTransparency = 0
	hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee             = model
	hl.Parent              = gui
	entry.highlight        = hl

	local anchor
	if model:IsA("BasePart") then
		anchor = model
	else
		anchor = model.PrimaryPart
			or model:FindFirstChildWhichIsA("BasePart", true)
	end

	if anchor then
		local bb = Instance.new("BillboardGui")
		bb.Name        = "PatrolESPLabel"
		bb.Size        = UDim2.fromOffset(160, 32)
		bb.StudsOffset = Vector3.new(0, ESP_LABEL_Y, 0)
		bb.AlwaysOnTop = true
		bb.Adornee     = anchor
		bb.Parent      = gui

		local lbl = Instance.new("TextLabel")
		lbl.Size                   = UDim2.fromScale(1, 1)
		lbl.BackgroundTransparency = 1
		lbl.Text                   = model.Name
		lbl.TextColor3             = Color3.new(1, 1, 1)
		lbl.TextStrokeTransparency = 0
		lbl.TextStrokeColor3       = Color3.new(0, 0, 0)
		lbl.Font                   = Enum.Font.GothamBold
		lbl.TextSize               = 14
		lbl.Parent                 = bb

		entry.billboard = bb
		entry.label     = lbl
		entry.anchor    = anchor

		entry.conns[#entry.conns + 1] = RunService.RenderStepped:Connect(function()
			if not model.Parent or not anchor.Parent then return end
			local char = LocalPlayer.Character
			local hrp  = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local dist = (anchor.Position - hrp.Position).Magnitude
				lbl.Text = model.Name .. "  [" .. math.floor(dist) .. "m]"
			end
		end)
	end

	entry.conns[#entry.conns + 1] = model.AncestryChanged:Connect(function(_, p)
		if not p then removeESP(model) end
	end)

	patrolState.esp[model] = entry
end

removeESP = function(model)
	local entry = patrolState.esp[model]
	if not entry then return end
	patrolState.esp[model] = nil

	for _, c in ipairs(entry.conns or {}) do
		pcall(function() c:Disconnect() end)
	end
	if entry.highlight then pcall(function() entry.highlight:Destroy() end) end
	if entry.billboard then pcall(function() entry.billboard:Destroy() end) end
end

local function refreshESP()
	if not PATROL_PATH or not PATROL_PATH.Parent then
		PATROL_PATH = workspace:FindFirstChild("Patrol")
		if not PATROL_PATH then return end
	end

	local seen = {}
	for _, child in ipairs(PATROL_PATH:GetChildren()) do
		if child:IsA("Model") or child:IsA("BasePart") then
			seen[child] = true
			if not patrolState.esp[child] then
				addESP(child)
			end
		end
	end

	for model in pairs(patrolState.esp) do
		if not seen[model] or not model.Parent then
			removeESP(model)
		end
	end
end

local function clearAllESP()
	for model in pairs(patrolState.esp) do
		removeESP(model)
	end
end

local function startPatrolLoop()
	if patrolState.loopRunning then return end
	patrolState.loopRunning = true

	task.spawn(function()
		while patrolState.enabled do
			refreshESP()
			task.wait(SCAN_INTERVAL)
		end
		clearAllESP()
		patrolState.loopRunning = false
	end)
end

local function setPatrolEnabled(state)
	patrolState.enabled = state

	if state then
		if not PATROL_PATH then
			PATROL_PATH = workspace:FindFirstChild("Patrol")
		end
		if not PATROL_PATH then
			notify("Patrol ESP", "workspace.Patrol not found.", "error", 3)
			patrolState.enabled = false
			return
		end
		startPatrolLoop()
		setStatus("Patrol ESP on")
	else
		clearAllESP()
		setStatus("Patrol ESP off")
	end
end

