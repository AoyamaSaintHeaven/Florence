local function doScan()
	if scanState.isScanning then return end
	scanState.isScanning = true
	clearResults()

	local term = inputTerm.Text
	if term == "" then
		statusLbl.Text = "Enter a keyword first."
		statusLbl.TextColor3 = P.Bad
		scanState.isScanning = false
		return
	end

	statusLbl.Text = 'Scanning for "' .. term .. '"…'
	statusLbl.TextColor3 = P.Sub
	setStatus("Scanning…", "warn")

	local needle = scanState.caseSensitive and term or term:lower()
	local exact = scanState.exactMatch

	task.spawn(function()
		local descendants = workspace:GetDescendants()
		local total = #descendants
		local found = 0
		local scanned = 0
		local lastUpdate = tick()

		for _, inst in ipairs(descendants) do
			scanned += 1
			local name = inst.Name
			local target = scanState.caseSensitive and name or name:lower()

			local matched
			if exact then
				matched = (target == needle)
			else
				matched = target:find(needle, 1, true) ~= nil
			end

			if matched then
				found += 1
				table.insert(scanState.results, inst)
				addResultRow(inst, found)
				if found >= MAX_RESULTS then break end
			end

			if tick() - lastUpdate > 0.1 then
				lastUpdate = tick()
				local pct = scanned / total
				progressFill.Size = UDim2.new(pct, 0, 1, 0)
				statusLbl.Text = string.format(
					"Scanning…  %d / %d   |   %d matches",
					scanned, total, found)
				task.wait()
			end
		end

		progressFill.Size = UDim2.new(1, 0, 1, 0)

		if found >= MAX_RESULTS then
			statusLbl.Text = "Hit cap (" .. MAX_RESULTS .. ")."
			statusLbl.TextColor3 = P.Warn
			setStatus("Hit cap", "warn")
		else
			statusLbl.Text = string.format(
				"Done — scanned %d, found %d.", scanned, found)
			statusLbl.TextColor3 = found > 0 and P.Good or P.Sub
			setStatus("Scan complete")
		end

		resultCountLbl.Text = found == 0
			and "No matches."
			or string.format("%d match%s.", found, found == 1 and "" or "es")
		resultCountLbl.TextColor3 = found > 0 and P.Good or P.Muted

		notify("Scanner",
			string.format("Found %d match%s.", found, found == 1 and "" or "es"),
			found > 0 and "success" or "info", 3)

		scanState.isScanning = false
		progressFill.Size = UDim2.new(0, 0, 1, 0)
	end)
end

