local function updatePrompts()
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then
			if promptState.isEnabled then
				if promptState.originalDurations[descendant] == nil then
					promptState.originalDurations[descendant] = descendant.HoldDuration
				end
				descendant.HoldDuration = 0
			else
				if promptState.originalDurations[descendant] ~= nil then
					descendant.HoldDuration = promptState.originalDurations[descendant]
					promptState.originalDurations[descendant] = nil
				end
			end
		end
	end
end

local function countPrompts()
	local n = 0
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then n += 1 end
