local function makeSlider(parent, title, min, max, default, callback)
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
	}, parent)

	new("TextLabel", {
		Size = UDim2.new(1, -60, 0, 16),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = P.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = fs(11),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, holder)

	local valLbl = new("TextLabel", {
		Size = UDim2.fromOffset(60, 16),
		Position = UDim2.new(1, -60, 0, 0),
		BackgroundTransparency = 1,
		Text = string.format("%.1f", default),
		TextColor3 = P.Accent,
		Font = Enum.Font.GothamBold,
		TextSize = fs(11),
		TextXAlignment = Enum.TextXAlignment.Right,
	}, holder)

	local trackPad = new("Frame", {
		Size = UDim2.new(1, 0, 0, IS_MOBILE and 22 or 16),
		Position = UDim2.fromOffset(0, 20),
		BackgroundTransparency = 1,
	}, holder)

	local track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 5),
		Position = UDim2.new(0, 0, 0.5, -2.5),
		BackgroundColor3 = P.PanelAlt,
		BorderSizePixel = 0,
	}, trackPad)
	corner(3, track)

	local fill = new("Frame", {
		Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
		BackgroundColor3 = P.Accent,
		BorderSizePixel = 0,
	}, track)
	corner(3, fill)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14),
		Position = UDim2.new((default - min) / (max - min), -7, 0.5, -7),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
	}, track)
	corner(7, knob)

	local dragging = false
	local function setVal(v)
		v = math.clamp(v, min, max)
		local alpha = (v - min) / (max - min)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, -7, 0.5, -7)
		valLbl.Text = string.format("%.1f", v)
		if callback then callback(v) end
	end

	local function getFromInput(input)
		local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
		setVal(min + (max - min) * rel)
	end

	trackPad.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			getFromInput(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			getFromInput(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return { set = setVal }
end

