	if promptState.isEnabled then
		promptState.descendantConnection =
			workspace.DescendantAdded:Connect(function(d)
				if promptState.isEnabled and d:IsA("ProximityPrompt") then
					if promptState.originalDurations[d] == nil then
						promptState.originalDurations[d] = d.HoldDuration
					end
					d.HoldDuration = 0
