--  TAB 2 — AUTO CLAIM  (drop-in TP + camera look-down + fire)
-- ============================================================
local claimPage = makeTab("claim", "🎁", "Auto Claim")

local HALLOWEEN_NAME    = "Halloween"
local SPAWN_NAME        = "SpawnPoint"
local ITEM_KEYWORD      = "item"
local DROP_HEIGHT       = 2      -- small hop above the item
local TWEEN_UP_TIME     = 0.45
local TWEEN_DOWN_TIME   = 0.35
local STAND_OFFSET      = 1
local DETECT_RADIUS     = 5
local CAMERA_HOLD_TIME  = 0.45
local FIRE_COOLDOWN     = 0.75
local VANISH_TIMEOUT    = 20

local claimState = {
	enabled     = false,
	loopRunning = false,
	fired       = {},
	isTweening  = false,
	claimCount  = 0,
	itemsSeen   = 0,
	currentName = "-",
}

local function getSpawnPath()
	local halloween = workspace:FindFirstChild(HALLOWEEN_NAME)
	if not halloween then return nil end
	return halloween:FindFirstChild(SPAWN_NAME)
end

local function isItemInstance(inst)
	if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
	return inst.Name:lower():find(ITEM_KEYWORD, 1, true) ~= nil
end

local function getModelAnchor(model)
	if model:IsA("BasePart") then return model end
	if model.PrimaryPart then return model.PrimaryPart end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function stillExists(model, spawnPath)
	if not model or not model.Parent then return false end
	if spawnPath and not model:IsDescendantOf(spawnPath) then return false end
	return true
end

local function firePromptsIn(model)
	local now = tick()
	local count = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local last = claimState.fired[d]
			if not last or (now - last) > FIRE_COOLDOWN then
				claimState.fired[d] = now
				pcall(function()
					d.Enabled      = true
					d.HoldDuration = 0
					d:InputHoldBegin()
					d:InputHoldEnd()
				end)
				count += 1
			end
		end
	end
	return count
end

-- Drop-in TP: small hop above the model → land on it
local function tweenDropIn(model)
	local anchor = getModelAnchor(model)
	if not anchor then return false end

	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	local targetPos = anchor.Position
	local abovePos  = targetPos + Vector3.new(0, DROP_HEIGHT, 0)
	local landPos   = targetPos + Vector3.new(0, 0, STAND_OFFSET)

	claimState.isTweening = true

	-- PHASE 1: hop above the item, HRP facing down at it
	local upTween = TweenService:Create(
		hrp,
		TweenInfo.new(TWEEN_UP_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = CFrame.new(abovePos, targetPos) }
	)
	upTween:Play()
	upTween.Completed:Wait()

	task.wait(0.08)

	-- PHASE 2: drop onto the item, HRP facing it
	local downTween = TweenService:Create(
		hrp,
		TweenInfo.new(TWEEN_DOWN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ CFrame = CFrame.new(landPos, targetPos) }
	)
	downTween:Play()
	downTween.Completed:Wait()

	claimState.isTweening = false
	return true
end

-- Force the camera to look DOWN at the item's prompt for a brief moment
local function forceCameraLookDown(model)
	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	local anchor = getModelAnchor(model)
	if not (hrp and anchor) then return end

	local targetPos = anchor.Position

	local prevSubject = Camera.CameraSubject

	pcall(function()
		Camera.CameraType = Enum.CameraType.Scriptable
		local camPos = hrp.Position + Vector3.new(0, 7, 0)
		Camera.CFrame = CFrame.new(camPos, targetPos)
		Camera.Focus = CFrame.new(targetPos)
	end)

	task.wait(CAMERA_HOLD_TIME)

	local fired = firePromptsIn(model)
	if fired > 0 then
		claimState.claimCount += fired
		local dist = (anchor.Position - hrp.Position).Magnitude
		notify("Auto Claim",
			string.format("Claimed %s  (%d prompt%s, %.1f studs)",
				model.Name, fired, fired == 1 and "" or "s", dist),
			"success", 2)
	end

	pcall(function()
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			Camera.CameraSubject = hum
		elseif prevSubject then
			Camera.CameraSubject = prevSubject
		end
		Camera.CameraType = Enum.CameraType.Custom
	end)
end

local function processItem(model)
	claimState.currentName = model.Name

	tweenDropIn(model)
	task.wait(0.1)

	local char = LocalPlayer.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	local anchor = getModelAnchor(model)
	if not (hrp and anchor) then return end

	local dist = (anchor.Position - hrp.Position).Magnitude
	if dist > DETECT_RADIUS then return end

	forceCameraLookDown(model)

	local startTime = tick()
	while claimState.enabled do
		local spawnPath = getSpawnPath()
		if not stillExists(model, spawnPath) then
			return
		end
		if tick() - startTime > VANISH_TIMEOUT then
			notify("Auto Claim", "Gave up on " .. model.Name, "warn", 2)
			return
		end
		local reFired = firePromptsIn(model)
		if reFired > 0 then
			claimState.claimCount += reFired
		end
		task.wait(0.25)
	end
end

local function collectItems(sortByDistance)
	local list = {}
	local spawnPath = getSpawnPath()
	if not spawnPath then return list end

	for _, inst in ipairs(spawnPath:GetDescendants()) do
		if isItemInstance(inst) then
			table.insert(list, inst)
		end
	end

	if sortByDistance then
		local char = LocalPlayer.Character
		local hrp  = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			table.sort(list, function(a, b)
				local aA = getModelAnchor(a)
				local bA = getModelAnchor(b)
				if not aA or not bA then return aA ~= nil end
				return (aA.Position - hrp.Position).Magnitude
				     < (bA.Position - hrp.Position).Magnitude
			end)
		end
	end

	return list
end

local function startClaimLoop()
	if claimState.loopRunning then return end
	claimState.loopRunning = true

	task.spawn(function()
		while claimState.enabled do
			local spawnPath = getSpawnPath()

			if not spawnPath then
				claimState.itemsSeen = 0
				task.wait(0.5)
			else
				local items = collectItems(true)
				claimState.itemsSeen = #items

				if #items == 0 then
					claimState.currentName = "-"
					task.wait(0.35)
				else
					processItem(items[1])
				end
			end
		end
		claimState.loopRunning = false
	end)
end

local function setClaimEnabled(state)
	claimState.enabled = state

	if state then
		if not getSpawnPath() then
			notify("Auto Claim",
				"workspace." .. HALLOWEEN_NAME .. "." .. SPAWN_NAME
				.. " not found yet — will keep trying.",
				"warn", 3)
		end
		claimState.claimCount = 0
		claimState.fired = {}
		startClaimLoop()
		setStatus("Auto Claim on")
	else
		claimState.currentName = "-"
		setStatus("Auto Claim off")
	end
end

