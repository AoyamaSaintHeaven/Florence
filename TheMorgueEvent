local config = {
	accent        = "default",
	windowOpen    = true,
	scannerTerm   = "candy",
	scanCase      = false,
	scanExact     = false,
	instantPrompt = false,
	patrolESP     = false,
	autoClaim     = false,
	antiAfk       = false,
	walkSpeed     = 16,
	jumpPower     = 50,
	toggleX       = 20,
	toggleY       = 0.5,
}

local function supportsFS()
	return type(writefile) == "function" and type(readfile) == "function"
end

local function saveConfig()
	if not supportsFS() then return false end
	pcall(function()
		if type(isfolder) == "function" and not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end
		writefile(CONFIG_FILE, HttpService:JSONEncode(config))
	end)
	return true
end

local function loadConfig()
	if not supportsFS() then return end
	pcall(function()
		if type(isfile) == "function" and isfile(CONFIG_FILE) then
			local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
			for k, v in pairs(data) do config[k] = v end
		end
	end)
end

