	})
	new("UICorner", { CornerRadius = UDim.new(0, 5), Parent = uidPill })

	new("TextLabel", {
		Name = "UidLabel", BackgroundTransparency = 1,
		Position = UDim2.new(0, 6, 0, 0),
		Size = UDim2.new(1, -12, 1, 0),
		Font = Enum.Font.Code, Text = entry.uid,
		TextSize = 11, TextColor3 = C.uidFg,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = uidPill,
	})
	new("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 4),
		Parent = uidPill,
	})

	new("TextLabel", {
		Name = "Rarity", BackgroundTransparency = 1,
		Position = UDim2.new(0.50, 0, 0, 6),
		Size = UDim2.new(0.20, -6, 0, 18),
		Font = Enum.Font.GothamBold,
		Text = entry.rarity .. entry.mutText,
		TextSize = 11, TextColor3 = rarityColor(entry.rarity),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	new("TextLabel", {
		Name = "Money", BackgroundTransparency = 1,
		Position = UDim2.new(0.50, 0, 0, 30),
		Size = UDim2.new(0.20, -6, 0, 18),
		Font = Enum.Font.GothamBold,
		Text = "💰 $" .. fmtNum(entry.mps) .. "/s",
		TextSize = 11, TextColor3 = entry.mps and C.good or C.dim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	local hasCF = typeof(entry.cframe) == "CFrame"
	local flyBtn = new("TextButton", {
		Name = "Fly",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 78, 0, 30),
		BackgroundColor3 = hasCF and C.accent or Color3.fromRGB(68, 68, 82),
		Font = Enum.Font.GothamBold,
		Text = hasCF and "FLY" or "NO CF",
		TextSize = 11, TextColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, AutoButtonColor = hasCF,
		Parent = row,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 7), Parent = flyBtn })

	if hasCF then
		flyBtn.MouseButton1Click:Connect(function()
			if not scriptEnabled then
				showToast("⚠️ Enable the scanner first", C.warn)
				return
			end
			local live = findEggPart(entry.uid)
			local cf = live and live.CFrame or entry.cframe
			entry.cframe = cf
			task.spawn(flyCharacterTo, cf, entry.uid)
		end)
	end
end

-- ────────────────────────────────────────────────────────────────
--  REFRESH
-- ────────────────────────────────────────────────────────────────
local refreshing = false

local function refresh()
	if refreshing then return end
	refreshing = true

	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	rowIndex = 0

	if not eggState then
		statusLabel.Text = "⚠️  Could not load ReplicatedStorage.Client.EggState"
		statusLabel.TextColor3 = C.bad
		statusLabel.Visible = true
		countLabel.Text = "error"
		topCount.Text = "error"
		refreshing = false
		return
	end

	local entries = collectEntries()
	local filter  = searchBox.Text:lower()
	local shown   = 0

	for _, entry in ipairs(entries) do
		if filter == "" or entry.searchText:find(filter, 1, true) then
			renderRow(entry)
			shown += 1
			if shown >= CONFIG.MaxRows then break end
		end
	end

	if shown == 0 then
		statusLabel.Text = (#entries == 0)
			and "No field eggs detected."
			or "No eggs match your search."
		statusLabel.TextColor3 = C.dim
		statusLabel.Visible = true
	else
		statusLabel.Visible = false
	end

	local countText = string.format("%d egg%s", shown, shown == 1 and "" or "s")
	countLabel.Text = countText
	topCount.Text   = countText
	refreshing = false
end

-- expose for the power toggle to force-refresh
_G.__EggRefresh = refresh

local searchDebounce
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	if searchDebounce then task.cancel(searchDebounce) end
	searchDebounce = task.delay(0.25, refresh)
end)

returnBtn.MouseButton1Click:Connect(returnCharacter)

-- ────────────────────────────────────────────────────────────────
--  LIVE AUTO-REFRESH  (gated by scriptEnabled)
-- ────────────────────────────────────────────────────────────────
task.spawn(function()
	task.wait(1)
	refresh()   -- show the list once on load even before enabling
end)

if CONFIG.AutoRefresh > 0 then
	task.spawn(function()
		while gui.Parent do
			task.wait(CONFIG.AutoRefresh)
			if not scriptEnabled then continue end
			if gui.Parent and not isFlying and not isDropping then
				refresh()
			end
		end
	end)
end

-- ────────────────────────────────────────────────────────────────
--  START DROP WATCHER
-- ────────────────────────────────────────────────────────────────
task.spawn(watchDropHeldEgg)

print("[EggScanner] v12d loaded (MASTER TOGGLE — starts OFF). "
	.. (eggState and "EggState OK" or "EggState MISSING"))
