	bg     = Color3.fromRGB(20, 20, 26),
	bar    = Color3.fromRGB(32, 32, 42),
	panel  = Color3.fromRGB(28, 28, 36),
	row    = Color3.fromRGB(31, 31, 40),
	rowAlt = Color3.fromRGB(36, 36, 46),
	stroke = Color3.fromRGB(58, 58, 74),
	text   = Color3.fromRGB(236, 236, 245),
	dim    = Color3.fromRGB(150, 150, 168),
	accent = Color3.fromRGB(0, 170, 255),
	good   = Color3.fromRGB(90, 220, 140),
	bad    = Color3.fromRGB(255, 95, 110),
	warn   = Color3.fromRGB(255, 190, 70),
	uidBg  = Color3.fromRGB(42, 42, 56),
	uidFg  = Color3.fromRGB(180, 200, 235),
}

local function new(class, props)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	if parent then inst.Parent = parent end
	return inst
end

local SUFFIX = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp"}
local function fmtNum(n)
	n = tonumber(n)
	if not n then return "?" end
	local neg = n < 0
	n = math.abs(n)
	local i = 1
	while n >= 1000 and i < #SUFFIX do
		n = n / 1000
		i += 1
	end
	local s
	if i == 1 then
		s = (n % 1 == 0) and string.format("%d", n) or string.format("%.2f", n)
	else
		s = (n >= 100) and string.format("%d", math.floor(n + 0.5)) or string.format("%.2f", n)
	end
	return (neg and "-" or "") .. s .. SUFFIX[i]
end

local RARITY_COLORS = {
	Common    = Color3.fromRGB(190, 190, 200),
	Uncommon  = Color3.fromRGB(120, 220, 120),
	Rare      = Color3.fromRGB(90, 160, 255),
	Epic      = Color3.fromRGB(190, 110, 255),
	Legendary = Color3.fromRGB(255, 190, 70),
	Mythical  = Color3.fromRGB(255, 90, 120),
	Secret    = Color3.fromRGB(255, 255, 255),
	Exclusive = Color3.fromRGB(255, 140, 60),
}
local function rarityColor(name)
	local s = tostring(name):lower()
	for k, v in pairs(RARITY_COLORS) do
		if s:find(k:lower(), 1, true) then return v end
	end
	return Color3.fromRGB(205, 205, 215)
end

local function pick(tbl, keys)
	if type(tbl) ~= "table" then return nil end
	for _, k in ipairs(keys) do
		local v = tbl[k]
		if v ~= nil then return v end
	end
	return nil
end

-- ────────────────────────────────────────────────────────────────
--  EGG LOOKUP
-- ────────────────────────────────────────────────────────────────
local uidPartCache    = {}
local uidAttributeMap = nil
local attributeScanDone = false

local UID_ATTRIBUTES = {
	"UID", "Uid", "uid", "EggUID", "EggId", "EggID",
	"RecordId", "RecordUID", "Id", "ID",
}

local function buildAttributeMap()
	local map = {}
	pcall(function()
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("BasePart") then
				for _, attr in ipairs(UID_ATTRIBUTES) do
					local ok2, v = pcall(function() return d:GetAttribute(attr) end)
					if ok2 and v ~= nil then map[tostring(v)] = d end
				end
			end
		end
	end)
	return map
end

local function findEggPart(uid)
	local key = tostring(uid)
	local cached = uidPartCache[key]
	if cached and cached.Parent then return cached end

	local ok, found = pcall(function() return workspace:FindFirstChild(key, true) end)
	if ok and found then
		local part = found:IsA("BasePart") and found
			or found:FindFirstChildWhichIsA("BasePart", true)
		if part then uidPartCache[key] = part return part end
	end

	if #key > 8 then
		local ok2, found2 = pcall(function() return workspace:FindFirstChild(key:sub(1, 8), true) end)
		if ok2 and found2 then
			local part = found2:IsA("BasePart") and found2
				or found2:FindFirstChildWhichIsA("BasePart", true)
			if part then uidPartCache[key] = part return part end
		end
	end

	if not attributeScanDone then
		attributeScanDone = true
		uidAttributeMap = buildAttributeMap()
	end
	local fromAttr = uidAttributeMap and uidAttributeMap[key]
	if fromAttr and fromAttr.Parent then
		uidPartCache[key] = fromAttr
		return fromAttr
	end
	return nil
end

local function resolveCFrame(record, uid)
	local bottom = record.BottomCFrame
	if typeof(bottom) == "CFrame" then return bottom end

	for _, key in ipairs(FIELDS.CFrame) do
		local v = record[key]
		if typeof(v) == "CFrame" then return v end
	end

	local instVal = pick(record, FIELDS.Instance)
	if typeof(instVal) == "Instance" then
		local part = instVal:IsA("BasePart") and instVal
			or (instVal.PrimaryPart or instVal:FindFirstChildWhichIsA("BasePart", true))
		if part then return part.CFrame end
	end

	local posVal = pick(record, FIELDS.Position)
	if typeof(posVal) == "Vector3" then return CFrame.new(posVal) end
	if type(posVal) == "table" and posVal.X and posVal.Y and posVal.Z then
		return CFrame.new(Vector3.new(posVal.X, posVal.Y, posVal.Z))
	end

	local part = findEggPart(uid)
	return part and part.CFrame or nil
end

-- ────────────────────────────────────────────────────────────────
--  VALUE MATH
-- ────────────────────────────────────────────────────────────────
local function computeMoneyPerSecond(info, record)
	if not info then return nil end
	local base  = tonumber(info.EarningRate) or 0
	local scale = tonumber(pick(record, FIELDS.Scale)) or 1

	local scaleFactor = (scale > 5)
		and ((scale / 5) ^ 1.2) * 19.637875755794113
		or (scale ^ 1.85)

	local mutMult = 1
	if mutations and type(mutations.EarningsFor) == "function" then
		local ok, m = pcall(mutations.EarningsFor, record.Mutations or {})
		if ok and type(m) == "number" and m > 0 then mutMult = m end
	end

	return base * scaleFactor * mutMult
end

-- ────────────────────────────────────────────────────────────────
--  DATA EXTRACTION
-- ────────────────────────────────────────────────────────────────
local function buildEntry(key, record)
	local uid      = resolveUID(key, record)
	local category = tostring(pick(record, FIELDS.Category) or "?")
	local scale    = tonumber(pick(record, FIELDS.Scale)) or 1
	local info     = (assets and assets.Directory) and assets.Directory[category] or nil

	local displayName = category
	if info then displayName = info.DisplayName or info.Name or category end

	local rarity = "?"
	if info and info.Rarity then
		local r = info.Rarity
		if type(r) == "table" then
			rarity = r.DisplayName or r._id or r.Name or r.Id or "?"
		else
			rarity = tostring(r)
		end
	end

	local mps = computeMoneyPerSecond(info, record)

	local mutText = ""
	local mutVal = pick(record, FIELDS.Mutations)
	if type(mutVal) == "table" then
		local names = {}
		for k, v in pairs(mutVal) do
			local label = (type(k) == "string") and k or tostring(v)
			if mutations and mutations.Directory and mutations.Directory[label] then
				local m = mutations.Directory[label]
				label = m.DisplayName or m.Name or label
			end
			table.insert(names, tostring(label))
		end
		if #names > 0 then mutText = " [" .. table.concat(names, ", ") .. "]" end
	end

	local bottomCF = record.BottomCFrame
	if typeof(bottomCF) ~= "CFrame" then
		bottomCF = resolveCFrame(record, uid)
	end

	return {
		uid        = uid,
		name       = tostring(displayName),
		rarity     = tostring(rarity),
		mps        = mps,
		scale      = scale,
		mutText    = mutText,
		cframe     = bottomCF,
		searchText = (tostring(displayName) .. " " .. tostring(rarity) .. " " .. uid):lower(),
	}
end

local function collectEntries()
	local out = {}
	if not eggState then return out end

	local ok, result = pcall(function() return eggState.ReadFieldEggs() end)
	if not ok or type(result) ~= "table" then return out end

	local records = result.Records or result.records or result
	if type(records) ~= "table" then return out end

	for key, record in pairs(records) do
		if type(record) == "table"
			and record.State ~= "Claimed"
			and typeof(record.BottomCFrame) == "CFrame"
		then
			table.insert(out, buildEntry(key, record))
		end
	end

	table.sort(out, function(a, b)
		local am = a.mps or -1
		local bm = b.mps or -1
		if am == bm then
			if a.name == b.name then return a.uid < b.uid end
			return a.name < b.name
		end
		return am > bm
	end)

	return out
end

-- ────────────────────────────────────────────────────────────────
--  ANTI-PUSH HELPERS
-- ────────────────────────────────────────────────────────────────
local function disableCharacterCollision(char)
	local saved = {}
	if not char then return saved end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			saved[d] = d.CanCollide
			d.CanCollide = false
		end
	end
	return saved
end

local function restoreCharacterCollision(saved)
	for part, state in pairs(saved) do
		if part and part.Parent then
			part.CanCollide = state
		end
	end
end

-- ⭐ Forward declarations
local gui, main

-- ⭐⭐⭐ MASTER POWER SWITCH — OFF by default
-- Nothing runs (no flight, no hop, no drop remote, no auto-refresh)
-- until the player presses the POWER button.
local scriptEnabled = false

-- ────────────────────────────────────────────────────────────────
--  TOAST
-- ────────────────────────────────────────────────────────────────
local toast
local function showToast(msg, color)
	if toast then toast:Destroy() end
	toast = new("TextLabel", {
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(0, 240, 0, 28),
		BackgroundColor3 = color or C.good,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = msg,
		TextSize = 12,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 10,
		Parent = main,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 6), Parent = toast })
	task.delay(1.8, function()
		if toast then toast:Destroy() toast = nil end
	end)
end

-- ────────────────────────────────────────────────────────────────
--  CHARACTER HELPERS
-- ────────────────────────────────────────────────────────────────
local isFlying = false
local isDropping = false
local savedHRP = nil

local function getHRP()
	local char = LocalPlayer.Character
	if not char then return nil, nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	return hrp, hum
end

local function isAtForest()
	local hrp = getHRP()
	if not hrp then return false end
	local z = CONFIG.ForestZ or hrp.Position.Z
	local target = Vector3.new(CONFIG.ForestX, CONFIG.ForestY, z)
	local dist = (hrp.Position - target).Magnitude
	return dist <= CONFIG.ForestArriveRadius, dist
end

-- ────────────────────────────────────────────────────────────────
--  BODY-VELOCITY FLIGHT  (to egg)
-- ────────────────────────────────────────────────────────────────
local function flyCharacterTo(targetCFrame, claimUid)
	if not scriptEnabled then
		showToast("⚠️ Scanner is OFF", C.warn)
		return
	end
	if not targetCFrame or isFlying then return end

	local hrp, hum = getHRP()
	if not hrp then return end
	local char = hrp.Parent

	if not savedHRP then savedHRP = hrp.CFrame end

	isFlying = true

	local landPos = targetCFrame.Position + CONFIG.LandOffset

	local origWalk, origJump
	if hum and CONFIG.LockMovement then
		origWalk = hum.WalkSpeed
		origJump = hum.JumpPower
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	end

	local savedCollide = {}
	if CONFIG.DisableCollisions then
		savedCollide = disableCharacterCollision(char)
	end

	hrp.AssemblyLinearVelocity  = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero

	local bv = Instance.new("BodyVelocity")
	bv.Name = "EggScannerFly"
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bv.P = 1250
	bv.Velocity = Vector3.zero
	bv.Parent = hrp

	local bg = Instance.new("BodyGyro")
	bg.Name = "EggScannerGyro"
	bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bg.P = 10000
	bg.D = 500
	bg.CFrame = CFrame.new(hrp.Position, landPos)
	bg.Parent = hrp

	local elapsed = 0
	local arrived = false
	while isFlying do
		if not hrp.Parent then break end
		if not scriptEnabled then break end
		local cur  = hrp.Position
		local diff = landPos - cur
		local dist = diff.Magnitude
		if dist <= CONFIG.ArriveRadius then arrived = true break end

		local dir = diff.Unit
		bv.Velocity = dir * CONFIG.FlySpeed
		bg.CFrame   = CFrame.new(cur, cur + dir)

		elapsed = elapsed + RunService.Heartbeat:Wait()
		if elapsed >= CONFIG.MaxFlyTime then break end
	end

	if bv then bv:Destroy() end
	if bg then bg:Destroy() end

	if hrp.Parent then
		hrp.AssemblyLinearVelocity  = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		if CONFIG.SnapOnArrival then
			hrp.CFrame = CFrame.lookAt(landPos, targetCFrame.Position)
		end
	end

	if CONFIG.DisableCollisions then
		restoreCharacterCollision(savedCollide)
	end
	if hum and CONFIG.LockMovement then
		hum.WalkSpeed = origWalk or 16
		hum.JumpPower = origJump or 50
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	isFlying = false

	if arrived and claimUid and CONFIG.AutoClaim and scriptEnabled then
		task.wait(CONFIG.ClaimDelay)
		local ok, err = claimEgg(claimUid)
		if ok then showToast("✓ Claimed egg", C.good)
		else showToast("✕ Claim failed: " .. tostring(err), C.bad) end
	end
end

local function returnCharacter()
	if not scriptEnabled then
		showToast("⚠️ Scanner is OFF", C.warn)
		return
	end
	if not savedHRP or isFlying then return end
	local destination  = savedHRP
	local targetCFrame = CFrame.new(destination.Position)
	task.spawn(function()
		flyCharacterTo(targetCFrame, nil)
		savedHRP = nil
	end)
end

-- ────────────────────────────────────────────────────────────────
--  EXACT MULTI-HOP TO FOREST
-- ────────────────────────────────────────────────────────────────
local function multiHopToForest()
	if not scriptEnabled then return false end
	if isFlying then
		if CONFIG.Debug then warn("[EggScanner] multi-hop aborted: isFlying already true") end
		return false
	end

	local hrp, hum = getHRP()
	if not hrp then
		if CONFIG.Debug then warn("[EggScanner] multi-hop aborted: no HumanoidRootPart") end
		return false
	end
	local char = hrp.Parent

	pcall(function() hrp:SetNetworkOwner(LocalPlayer) end)

	isFlying = true

	local z = CONFIG.ForestZ or hrp.Position.Z

	if CONFIG.Debug then
		print(string.format(
			"[EggScanner] EXACT multi-hop START: (%.1f, %.1f, %.1f)  Z=%.1f  waypoints=%d",
			hrp.Position.X, hrp.Position.Y, hrp.Position.Z, z, #CONFIG.HopWaypoints
		))
	end

	local origWalk, origJump, origPlatform, origAutoRotate
	if hum then
		origWalk        = hum.WalkSpeed
		origJump        = hum.JumpPower
		origPlatform    = hum.PlatformStand
		origAutoRotate  = hum.AutoRotate
		hum.WalkSpeed    = 0
		hum.JumpPower    = 0
		hum.PlatformStand = true
		hum.AutoRotate   = false
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
	end

	local savedCollide = {}
	if CONFIG.DisableCollisions then
		savedCollide = disableCharacterCollision(char)
	end

	hrp.AssemblyLinearVelocity  = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero

	local waypoints = CONFIG.HopWaypoints
	local lastReachedIdx = 0

	for i = 1, #waypoints do
		if not hrp.Parent then break end
		if not scriptEnabled then break end

		local wp = waypoints[i]
		local target = Vector3.new(wp[1], wp[2], z)

		hrp.CFrame = CFrame.new(target)
		if (hrp.Position - target).Magnitude > 1 then
			hrp.Position = target
		end

		lastReachedIdx = i

		if CONFIG.Debug and (i <= 5 or i % 5 == 0 or i == #waypoints) then
			print(string.format(
				"[EggScanner]   hop %d/%d: target=(%.2f, %.2f)  actual=(%.2f, %.2f)",
				i, #waypoints, wp[1], wp[2], hrp.Position.X, hrp.Position.Y
			))
		end

		if CONFIG.HopDelay > 0 then task.wait(CONFIG.HopDelay)
		else RunService.Heartbeat:Wait() end
	end

	if hrp.Parent then
		local final = Vector3.new(CONFIG.ForestX, CONFIG.ForestY, z)
		hrp.CFrame = CFrame.new(final)
		if (hrp.Position - final).Magnitude > 1 then
			hrp.Position = final
		end
		hrp.AssemblyLinearVelocity  = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end

	if CONFIG.DisableCollisions then
		restoreCharacterCollision(savedCollide)
	end
	if hum then
		hum.WalkSpeed     = origWalk or 16
		hum.JumpPower     = origJump or 50
		hum.PlatformStand = origPlatform or false
		hum.AutoRotate    = origAutoRotate ~= false
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
	end

	local atForest, finalDist = isAtForest()
	if CONFIG.Debug then
		print(string.format(
			"[EggScanner] EXACT multi-hop DONE: hop=%d/%d  X=%.2f  dist to forest=%.2f  atForest=%s",
			lastReachedIdx, #waypoints, hrp.Position.X, finalDist or -1, tostring(atForest)
		))
	end

	isFlying = false
	return lastReachedIdx == #waypoints and atForest
end

-- ────────────────────────────────────────────────────────────────
--  DROP-HELD-EGG WATCHER  (rising-edge only)
-- ────────────────────────────────────────────────────────────────
local DROPGUI_EXACT = {
	["DropHeldEgg"]    = true,
	["DropHeldEggGui"] = true,
	["DropHeldEggGUI"] = true,
	["HeldEgg"]        = true,
	["HeldEggGui"]     = true,
	["DropEgg"]        = true,
	["DropEggGui"]     = true,
	["EggDrop"]        = true,
	["EggDropGui"]     = true,
	["DropButton"]     = true,
}

local function isDropHeldEggEnabled()
	for _, g in ipairs(PlayerGui:GetDescendants()) do
		if g:IsA("ScreenGui") or g:IsA("GuiObject") then
			if DROPGUI_EXACT[g.Name] then
				local on = false
				if g:IsA("ScreenGui") then on = g.Enabled
				else on = g.Visible end
				if on then
					if CONFIG.Debug then
						print("[EggScanner] matched GUI: " .. g:GetFullName())
					end
					return true
				end
			end
		end
	end
	return false
end

local function watchDropHeldEgg()
	task.wait(2)
	print("[EggScanner] drop watcher running")

	local wasEnabled = false
	local lastDropTime = 0

	while gui and gui.Parent do
		task.wait(CONFIG.DropCheckInterval)
		if not (gui and gui.Parent) then break end
		if not CONFIG.AutoDrop then continue end

		-- ⭐ Master switch — keep tracking state but don't act
		if not scriptEnabled then
			wasEnabled = isDropHeldEggEnabled()
			continue
		end

		local enabledNow = isDropHeldEggEnabled()
		local risingEdge = enabledNow and not wasEnabled
		wasEnabled = enabledNow

		if not risingEdge then continue end

		if isDropping or isFlying then
			if CONFIG.Debug then print("[EggScanner] edge detected but busy") end
			continue
		end

		if tick() - lastDropTime < CONFIG.DropCooldown then
			if CONFIG.Debug then print("[EggScanner] edge detected but cooldown active") end
			continue
		end

		isDropping = true
		showToast("✈ Flying to forest…", C.warn)
		if CONFIG.Debug then print("[EggScanner] DropHeldEgg ENABLED → starting multi-hop") end

		local ok = multiHopToForest()
		if CONFIG.Debug then print("[EggScanner] multiHopToForest returned: " .. tostring(ok)) end

		if ok and isAtForest() and scriptEnabled then
			task.wait(CONFIG.DropSettleDelay)
			if isAtForest() then
				local okDrop, err = dropHeldEgg()
				if okDrop then
					showToast("✓ Dropped egg", C.good)
					lastDropTime = tick()
					if CONFIG.Debug then print("[EggScanner] drop remote fired OK") end
				else
					showToast("✕ Drop failed: " .. tostring(err), C.bad)
				end
			else
				showToast("✕ Moved before drop — skip", C.bad)
			end
		else
			showToast("✕ Forest not reached — no drop", C.bad)
			if CONFIG.Debug then
				warn("[EggScanner] multi-hop did NOT reach forest — drop remote NOT fired")
			end
		end

		task.wait(1.5)
		isDropping = false
	end

	if CONFIG.Debug then print("[EggScanner] drop watcher exited") end
end

