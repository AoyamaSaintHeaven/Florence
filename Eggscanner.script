local rowIndex = 0

local function renderRow(entry)
	rowIndex += 1
	local isTop = (rowIndex == 1)

	local row = new("Frame", {
		Name = "Row",
		Size = UDim2.new(1, -6, 0, 58),
		BackgroundColor3 = isTop
			and Color3.fromRGB(40, 55, 75)
			or ((rowIndex % 2 == 0) and C.row or C.rowAlt),
		BorderSizePixel = 0,
		LayoutOrder = rowIndex,
		Parent = scroll,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = row })
	if isTop then
		new("UIStroke", {
			Color = C.accent, Thickness = 1, Transparency = 0.3, Parent = row,
		})
	end

	new("TextLabel", {
		Name = "PetName", BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 6),
