local FIELDS = {
	Category  = {"AssetCategory", "AssetId", "PetName", "Name", "Category"},
	Scale     = {"AssetScale", "Scale", "Size"},
	State     = {"State", "Status"},
	CFrame    = {"BottomCFrame", "TopCFrame", "CFrame", "Cframe", "Transform"},
	Position  = {"Position", "Pos", "WorldPosition", "Location"},
	Instance  = {"Obj", "Object", "Model", "Part", "Instance", "Egg"},
	Mutations = {"Mutations", "Mutation", "Mut"},
}

local UID_KEYS = {
	"UID", "Uid", "uid",
	"EggUID", "EggUid", "EggID", "EggId",
	"RecordUID", "RecordUid", "RecordID", "RecordId",
	"UUID", "Uuid", "uuid",
	"Id", "ID",
}

local function resolveUID(key, record)
	for _, k in ipairs(UID_KEYS) do
		local v = record[k]
		if v ~= nil then
			local t = type(v)
			if t == "string" and v ~= "" and not v:match("^table:") then
				return v
			elseif t == "number" then
				return tostring(v)
			end
		end
	end
	if type(key) == "string" and key ~= "" and not key:match("^table:") then
		return key
	end
	return tostring(key)
end

-- ────────────────────────────────────────────────────────────────
--  MODULE LOADING
-- ────────────────────────────────────────────────────────────────
local function waitForPath(root, ...)
	local node = root
	for _, seg in ipairs({...}) do
		local ok, child = pcall(function() return node:WaitForChild(seg, 10) end)
		if not ok or not child then return nil end
		node = child
	end
	return node
end

local function tryRequire(root, ...)
	local node = waitForPath(root, ...)
	if not node then return nil end
	local ok, mod = pcall(require, node)
	if not ok then
		warn("[EggScanner] Failed to require " .. tostring(node) .. ": " .. tostring(mod))
		return nil
	end
	return mod
end

local eggState   = tryRequire(ReplicatedStorage, "Client", "EggState")
local assets     = tryRequire(ReplicatedStorage, "Data", "Assets")
local eggRecords = tryRequire(ReplicatedStorage, "Shared", "Util", "EggRecords")
local mutations  = tryRequire(ReplicatedStorage, "Shared", "Modules", "Mutations")

-- ────────────────────────────────────────────────────────────────
--  REMOTES
-- ────────────────────────────────────────────────────────────────
local claimRemote, dropRemote = nil, nil

local function getClaimRemote()
	if claimRemote and claimRemote.Parent then return claimRemote end
	claimRemote = waitForPath(ReplicatedStorage, unpack(CONFIG.ClaimRemotePath))
	return claimRemote
end

local function getDropRemote()
	if dropRemote and dropRemote.Parent then return dropRemote end
	dropRemote = waitForPath(ReplicatedStorage, unpack(CONFIG.DropRemotePath))
	return dropRemote
end

local function claimEgg(uid)
	if not uid then return false, "no uid" end
	local remote = getClaimRemote()
	if not remote then
		warn("[EggScanner] Claim remote not found: " .. table.concat(CONFIG.ClaimRemotePath, "."))
		return false, "remote missing"
	end
	local ok, err = pcall(function() remote:InvokeServer({ Uid = tostring(uid) }) end)
	if not ok then
		warn("[EggScanner] Claim failed for " .. tostring(uid) .. ": " .. tostring(err))
		return false, tostring(err)
	end
	return true
end

local function dropHeldEgg()
	local remote = getDropRemote()
	if not remote then
		warn("[EggScanner] Drop remote not found: " .. table.concat(CONFIG.DropRemotePath, "."))
		return false, "remote missing"
	end
	local ok, err = pcall(function() remote:InvokeServer({ Reason = "PlayerRequest" }) end)
	if not ok then
		warn("[EggScanner] Drop failed: " .. tostring(err))
		return false, tostring(err)
	end
	return true
end

