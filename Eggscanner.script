-- ────────────────────────────────────────────────────────────────
--  DRAGGING
-- ────────────────────────────────────────────────────────────────
local function makeDraggable(frame, handles)
	local dragging, dragStart, startPos, dragInput

	local function beginDrag(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then return end
		dragging  = true
		dragStart = input.Position
		startPos  = frame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end

	for _, h in ipairs(handles) do
		h.InputBegan:Connect(beginDrag)
		h.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)
	end

	UserInputService.InputChanged:Connect(function(input)
		if not dragging or input ~= dragInput then return end
		local delta = input.Position - dragStart
		local vp  = getViewport()
		local sz  = frame.AbsoluteSize
		local nx  = math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, vp.X - sz.X))
		local ny  = math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, vp.Y - sz.Y))
		frame.Position = UDim2.new(0, nx, 0, ny)
	end)
end

makeDraggable(main, { topBar })

