local isMinimized = false
local expandedSize = nil

local function getViewport()
	local cam = workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(1280, 720)
end

local function clampToViewport()
	local vp = getViewport()
	local sz = main.AbsoluteSize
	local px, py = main.AbsolutePosition.X, main.AbsolutePosition.Y
	local maxX = math.max(0, vp.X - sz.X)
	local maxY = math.max(0, vp.Y - sz.Y)
	local nx = math.clamp(px, 0, maxX)
	local ny = math.clamp(py, 0, maxY)
	if nx ~= px or ny ~= py then
		main.Position = UDim2.new(0, nx, 0, ny)
	end
end

local function fitToScreen(center)
	if isMinimized then return end
	local vp = getViewport()
	local w = math.clamp(vp.X - CONFIG.EdgePadX * 2, CONFIG.MinWindowW, CONFIG.MaxWindowW)
	local h = math.clamp(vp.Y - CONFIG.EdgePadY * 2, CONFIG.MinWindowH, CONFIG.MaxWindowH)
	main.Size = UDim2.new(0, w, 0, h)
	if center then
		main.Position = UDim2.new(0, (vp.X - w) / 2, 0, (vp.Y - h) / 2)
	else
		clampToViewport()
	end
end

fitToScreen(true)

workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	fitToScreen(false)
	clampToViewport()
end)

