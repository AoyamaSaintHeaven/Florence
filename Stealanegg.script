--// SETTINGS TAB
--// ============================================================
local THUMB_GREEN=Color3.fromRGB(48,255,106)
local function thumbDot(p,x,y,col,s) local f=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(s,s),BackgroundColor3=col,BorderSizePixel=0},p); round(f,999); return f end
local function thumbRing(p,w,h,col,tr,th)
    local f=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(32,15),Size=UDim2.fromOffset(w,h),BackgroundTransparency=1,BorderSizePixel=0},p); round(f,math.floor(h/2))
    new("UIStroke",{Color=col,Thickness=th or 2,Transparency=tr or .3,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},f); return f
end
local THUMB_DECOR={
    ["Halo"]=function(th) thumbRing(th,46,19,THUMB_GREEN,.4,2) end,
    ["Rune Ring"]=function(th) local a=thumbDot(th,9,6,THUMB_GREEN,4); a.Rotation=45; local b=thumbDot(th,55,24,THUMB_GREEN,4); b.Rotation=45 end,
    ["Flame"]=function(th) thumbDot(th,32,4,Color3.fromRGB(255,122,28),5); thumbRing(th,46,19,Color3.fromRGB(255,122,28),.6,3) end,
    ["Lightning"]=function(th) new("Frame",{Position=UDim2.fromOffset(8,6),Size=UDim2.fromOffset(2,9),BackgroundColor3=Color3.fromRGB(40,200,255),BorderSizePixel=0},th); new("Frame",{Position=UDim2.fromOffset(54,16),Size=UDim2.fromOffset(2,9),BackgroundColor3=Color3.fromRGB(40,200,255),BorderSizePixel=0},th) end,
    ["Smoke"]=function(th) thumbDot(th,10,22,Color3.fromRGB(130,90,255),14) end,
    ["Sonar Rings"]=function(th) thumbRing(th,54,26,THUMB_GREEN,.5,1) end,
    ["Orbiting Orbs"]=function(th) thumbDot(th,9,6,Color3.fromRGB(40,200,255),5); thumbDot(th,55,24,THUMB_GREEN,5) end,
    ["Glitch"]=function(th) thumbRing(th,42,16,Color3.fromRGB(40,200,255),.2,1); thumbRing(th,40,14,Color3.fromRGB(255,59,210),.5,1) end,
    ["Sparkles"]=function(th) thumbDot(th,10,6,Color3.fromRGB(255,226,122),4); thumbDot(th,54,24,Color3.fromRGB(255,226,122),4) end,
    ["Aurora"]=function(th) thumbDot(th,12,15,THUMB_GREEN,30); thumbDot(th,52,15,Color3.fromRGB(130,90,255),30) end,
    ["Blood Drip"]=function(th) thumbRing(th,46,19,Color3.fromRGB(255,45,45),.4,2); thumbDot(th,32,27,Color3.fromRGB(196,13,13),3) end,
    ["Matrix Rain"]=function(th) new("TextLabel",{BackgroundTransparency=1,Text="01",TextColor3=THUMB_GREEN,Font=Enum.Font.Code,TextSize=9,Position=UDim2.fromOffset(4,1),Size=UDim2.fromOffset(20,10)},th); new("TextLabel",{BackgroundTransparency=1,Text="<>",TextColor3=THUMB_GREEN,Font=Enum.Font.Code,TextSize=9,Position=UDim2.fromOffset(40,17),Size=UDim2.fromOffset(20,10)},th) end,
    ["Fireflies"]=function(th) thumbDot(th,12,8,THUMB_GREEN,3); thumbDot(th,52,22,THUMB_GREEN,3); thumbDot(th,46,6,THUMB_GREEN,3) end,
    ["Frost"]=function(th) thumbRing(th,46,19,Color3.fromRGB(191,239,255),.5,2); thumbDot(th,10,22,Color3.fromRGB(232,248,255),3) end,
    ["Sunburst"]=function(th) thumbDot(th,6,15,Color3.fromRGB(255,210,74),3); thumbDot(th,58,15,Color3.fromRGB(255,210,74),3); thumbDot(th,32,3,Color3.fromRGB(255,210,74),3); thumbDot(th,32,27,Color3.fromRGB(255,210,74),3) end,
    ["Embers"]=function(th) thumbDot(th,10,25,Color3.fromRGB(255,138,42),3); thumbDot(th,54,5,Color3.fromRGB(255,138,42),3) end,
    ["Shadow"]=function(th) thumbDot(th,8,15,Color3.fromRGB(4,4,6),14); thumbRing(th,14,14,Color3.fromRGB(122,76,255),.2,1) end,
    ["Comet Trail"]=function(th) thumbDot(th,5,15,Color3.fromRGB(255,90,200),5); thumbDot(th,12,15,Color3.fromRGB(255,90,200),2); thumbDot(th,58,15,Color3.fromRGB(255,255,255),5) end,
    ["Gravity Pull"]=function(th) thumbDot(th,6,6,Color3.fromRGB(40,200,255),3); thumbDot(th,58,24,Color3.fromRGB(40,200,255),3); thumbDot(th,52,5,Color3.fromRGB(40,200,255),3) end,
}
local function drawThumb(th,name)
    local pill=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(32,15),Size=UDim2.fromOffset(34,12),BackgroundColor3=Color3.fromRGB(14,14,16),BorderSizePixel=0,ZIndex=3},th); round(pill,6)
    local ps=new("UIStroke",{Color=THUMB_GREEN,Thickness=1},pill)
    if THUMB_DECOR[name] then THUMB_DECOR[name](th) end
    return function(t) ps.Transparency=.2+.5*(.5+.5*math.sin(t*2.5)) end
end

