-- ══════════════════════════════════════════════════════════════════
--  FRIENDLY DROP  —  hop + drop logic
-- ══════════════════════════════════════════════════════════════════
local FriendlyDrop = {}
do
	local FD_RS  = game:GetService("ReplicatedStorage")
	local FD_Run = game:GetService("RunService")
	local FD_LP  = game:GetService("Players").LocalPlayer
	local FD_PG  = FD_LP:WaitForChild("PlayerGui")

	local CFG = {
		DropRemotePath = {"Packages", "Networking", "RF/EggWorld/AskFieldEggDrop"},
		CheckInterval  = 0.5,
		Cooldown       = 3,
		SettleDelay    = 0.15,
		ForestX        = 599.91,
		ForestY        = 72.17,
		ForestZ        = nil,
		ForestRadius   = 8,
		HopDelay       = 0,
		Debug          = true,
		HopWaypoints = {
			{3097.27, 72.31}, {2997.74, 72.31}, {2899.69, 72.31}, {2787.67, 72.31},
			{2738.44, 72.32}, {2704.82, 72.32}, {2600.35, 72.33}, {2438.60, 72.34},
			{2359.84, 72.35}, {2285.73, 72.35}, {2178.38, 72.36}, {1991.96, 72.36},
			{1933.81, 72.37}, {1821.70, 72.37}, {1731.50, 72.38}, {1657.21, 72.38},
			{1601.06, 72.41}, {1476.80, 72.49}, {1350.37, 72.57}, {1281.97, 72.57},
			{1111.38, 72.49}, {980.40, 72.42}, {956.22, 72.42}, {883.68, 72.42},
			{758.07, 72.43}, {613.34, 72.44}, {609.38, 72.41}, {602.18, 72.33},
			{599.91, 72.23}, {599.91, 72.17},
		},
	}

	local function waitForPath(root, ...)
		local node = root
		for _, seg in ipairs({...}) do
			local ok, child = pcall(function() return node:WaitForChild(seg, 10) end)
			if not ok or not child then return nil end
			node = child
		end
		return node
	end

	local function getHRP()
		local char = FD_LP.Character
		if not char then return nil, nil end
		return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
	end

	local function disableCharCollide(char)
		local saved = {}
		if not char then return saved end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				saved[d] = d.CanCollide
				d.CanCollide = false
			end
		end
		return saved
	end

	local function restoreCharCollide(saved)
		for p, s in pairs(saved) do
			if p and p.Parent then p.CanCollide = s end
		end
	end

	local dropRemote
	local function getDropRemote()
		if dropRemote and dropRemote.Parent then return dropRemote end
		dropRemote = waitForPath(FD_RS, unpack(CFG.DropRemotePath))
		return dropRemote
	end

	local function fireDrop()
		local r = getDropRemote()
		if not r then
			warn("[FriendlyDrop] Drop remote not found: " .. table.concat(CFG.DropRemotePath, "."))
			return false
		end
		local ok, err = pcall(function() r:InvokeServer({ Reason = "PlayerRequest" }) end)
		if not ok then warn("[FriendlyDrop] Drop failed: " .. tostring(err)); return false end
		if CFG.Debug then print("[FriendlyDrop] ✓ drop remote fired") end
		return true
	end

	local function isAtForest()
		local hrp = getHRP()
		if not hrp then return false end
		local z = CFG.ForestZ or hrp.Position.Z
		local target = Vector3.new(CFG.ForestX, CFG.ForestY, z)
		return (hrp.Position - target).Magnitude <= CFG.ForestRadius
	end

	local fdEnabled = false
	local isHopping = false

	local function multiHopToForest()
		if not fdEnabled or isHopping then return false end
		local hrp, hum = getHRP()
		if not hrp then return false end
		local char = hrp.Parent
		pcall(function() hrp:SetNetworkOwner(FD_LP) end)
		isHopping = true
		local z = CFG.ForestZ or hrp.Position.Z

		if CFG.Debug then
			print(string.format("[FriendlyDrop] HOP START: (%.1f, %.1f, %.1f) waypoints=%d",
				hrp.Position.X, hrp.Position.Y, hrp.Position.Z, #CFG.HopWaypoints))
		end

		local oW, oJ, oP, oAR
		if hum then
			oW, oJ = hum.WalkSpeed, hum.JumpPower
			oP, oAR = hum.PlatformStand, hum.AutoRotate
			hum.WalkSpeed = 0; hum.JumpPower = 0
			hum.PlatformStand = true; hum.AutoRotate = false
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
		end
		local savedC = disableCharCollide(char)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero

		local reached = 0
		for i, wp in ipairs(CFG.HopWaypoints) do
			if not hrp.Parent or not fdEnabled then break end
			local t = Vector3.new(wp[1], wp[2], z)
			hrp.CFrame = CFrame.new(t)
			if (hrp.Position - t).Magnitude > 1 then hrp.Position = t end
			reached = i
			if CFG.Debug and (i <= 5 or i % 5 == 0 or i == #CFG.HopWaypoints) then
				print(string.format("[FriendlyDrop]   hop %d/%d → (%.2f, %.2f)",
					i, #CFG.HopWaypoints, hrp.Position.X, hrp.Position.Y))
			end
			if CFG.HopDelay > 0 then task.wait(CFG.HopDelay) else FD_Run.Heartbeat:Wait() end
		end

		if hrp.Parent then
			local f = Vector3.new(CFG.ForestX, CFG.ForestY, z)
			hrp.CFrame = CFrame.new(f)
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
		restoreCharCollide(savedC)
		if hum then
			hum.WalkSpeed = oW or 16; hum.JumpPower = oJ or 50
			hum.PlatformStand = oP or false; hum.AutoRotate = oAR ~= false
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		end
		isHopping = false
		local ok = reached == #CFG.HopWaypoints and isAtForest()
		if CFG.Debug then print("[FriendlyDrop] HOP DONE atForest=" .. tostring(ok)) end
		return ok
	end

	local DROPGUI_NAMES = {
		["DropHeldEgg"]=true, ["DropHeldEggGui"]=true, ["DropHeldEggGUI"]=true,
		["HeldEgg"]=true, ["HeldEggGui"]=true,
		["DropEgg"]=true, ["DropEggGui"]=true,
		["EggDrop"]=true, ["EggDropGui"]=true, ["DropButton"]=true,
	}
	local function isDropGUIActive()
		for _, g in ipairs(FD_PG:GetDescendants()) do
			if g:IsA("ScreenGui") or g:IsA("GuiObject") then
				if DROPGUI_NAMES[g.Name] then
					local on = false
					if g:IsA("ScreenGui") then on = g.Enabled else on = g.Visible end
					if on then return true end
				end
			end
		end
		return false
	end

	task.spawn(function()
		task.wait(2)
		local wasOn, lastDropTime = false, 0
		local prevEnabled = false
		while true do
			task.wait(CFG.CheckInterval)

			-- ⭐ when toggle flips ON, reset wasOn so next ON counts as rising edge
			if fdEnabled and not prevEnabled then
				wasOn = false
			end
			prevEnabled = fdEnabled

			if not fdEnabled or isHopping then
				wasOn = isDropGUIActive()
				continue
			end

			local nowOn = isDropGUIActive()
			local rising = nowOn and not wasOn
			wasOn = nowOn
			if not rising then continue end
			if tick() - lastDropTime < CFG.Cooldown then continue end

			print("[FriendlyDrop] DropHeldEgg ENABLED → hop")
			local ok = multiHopToForest()
			if ok and isAtForest() and fdEnabled then
				task.wait(CFG.SettleDelay)
				if isAtForest() then
					if fireDrop() then lastDropTime = tick() end
				end
			end
			task.wait(1.5)
		end
	end)

	FriendlyDrop.SetEnabled = function(v) fdEnabled = not not v end
	FriendlyDrop.IsEnabled  = function() return fdEnabled end
	FriendlyDrop.Config     = CFG
end

Tabs.PlayerTab:Toggle({
	Title = "Friendly Drop",
	Desc = "Multi-hop to forest & drop held egg when DropHeldEgg opens",
	Value = false,
	Callback = function(state)
		FriendlyDrop.SetEnabled(state)
		FriendlyDrop.Config.Debug = state
		print("[FriendlyDrop] enabled = " .. tostring(state))
	end,
})

local Tabs = {
    MiscTab = Window:Tab({
        Title = "Misc",
        Icon = "121572094465765",
    }),
}

--[[
    Humanoid Swap Anti-Death Bypass
    --------------------------------
    - Cinoclone ang OldHumanoid, transfer lahat ng children, destroy old, parent clone
    - Sine-save/restore: JumpPower, JumpHeight, UseJumpPower, EvaluateStateMachine,
      at lahat ng 16 HumanoidStateType enabled states
    - LockHealth: MaxHealth/Health = math.huge
    - BlockDeathState: Dead=false, BreakJointsOnDeath=false, RequiresNeck=false
    - BindAntiDeath: HealthChanged + Died events
    - Background loop (0.1s): force-heal + disable Dead state
    - RefreshControls via PlayerModule
    - Camera.CameraSubject = NewHumanoid
    - Double-check pattern after 0.25s
    - Bound to Player.CharacterAdded + initial task.spawn
    - Lahat ng operations nasa pcall()
    - Hindi pinipigilan ang respawn — sine-swap lang ang humanoid pagka-load
--]]

-- ============================================================
-- SERVICES
-- ============================================================
local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local StarterGui        = game:GetService("StarterGui")

local LocalPlayer       = Players.LocalPlayer
local Camera            = Workspace.CurrentCamera

-- ============================================================
-- CONFIG / STATE
-- ============================================================
local isEnabled = false

local ALL_STATES = {
    Enum.HumanoidStateType.FallingDown,
    Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.GettingUp,
    Enum.HumanoidStateType.Landed,
    Enum.HumanoidStateType.Flying,
    Enum.HumanoidStateType.Freefall,
    Enum.HumanoidStateType.Seated,
    Enum.HumanoidStateType.PlatformStanding,
    Enum.HumanoidStateType.Dead,
    Enum.HumanoidStateType.Swimming,
    Enum.HumanoidStateType.Climbing,
    Enum.HumanoidStateType.StrafingNoPhysics,
    Enum.HumanoidStateType.Running,
    Enum.HumanoidStateType.RunningNoPhysics,
    Enum.HumanoidStateType.Physics,
    Enum.HumanoidStateType.None,
}

local ActiveConnections = {}

local function track(conn)
    if conn then
        table.insert(ActiveConnections, conn)
    end
    return conn
end

local function clearConnections()
    for _, c in ipairs(ActiveConnections) do
        pcall(function() c:Disconnect() end)
    end
    ActiveConnections = {}
end

local function safe(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[AntiDeath] " .. tostring(err))
    end
    return ok
end

local function SaveHumanoidProps(hum)
    local saved = {}
    pcall(function() saved.JumpPower          = hum.JumpPower          end)
    pcall(function() saved.JumpHeight         = hum.JumpHeight         end)
    pcall(function() saved.UseJumpPower       = hum.UseJumpPower       end)
    pcall(function() saved.EvaluateStateMachine = hum.EvaluateStateMachine end)
    pcall(function()
        saved.States = {}
        for _, st in ipairs(ALL_STATES) do
            saved.States[st] = hum:GetStateEnabled(st)
        end
    end)
    return saved
end

local function RestoreHumanoidProps(hum, saved)
    if not saved then return end
    pcall(function() if saved.JumpPower          ~= nil then hum.JumpPower          = saved.JumpPower          end end)
    pcall(function() if saved.JumpHeight         ~= nil then hum.JumpHeight         = saved.JumpHeight         end end)
    pcall(function() if saved.UseJumpPower       ~= nil then hum.UseJumpPower       = saved.UseJumpPower       end end)
    pcall(function() if saved.EvaluateStateMachine ~= nil then hum.EvaluateStateMachine = saved.EvaluateStateMachine end end)
    if saved.States then
        for st, enabled in pairs(saved.States) do
            pcall(function() hum:SetStateEnabled(st, enabled) end)
        end
    end
end

local function LockHealth(hum)
    safe(function()
        hum.MaxHealth = math.huge
        hum.Health    = math.huge
    end)
end

local function BlockDeathState(hum)
    safe(function() hum.BreakJointsOnDeath = false end)
    safe(function() hum.RequiresNeck       = false end)
    safe(function() hum.Dead               = false end)
end

local function BindAntiDeath(hum)
    track(hum.HealthChanged:Connect(function(h)
        if not isEnabled then return end
        pcall(function()
            if h < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end)
    end))

    track(hum.Died:Connect(function()
        if not isEnabled then return end
        pcall(function()
            hum.Dead   = false
            hum.Health = math.huge
        end)
    end))
end

local function StartBackgroundLoop(hum)
    track(RunService.Heartbeat:Connect(function()
        local now = tick()
        if not hum.Parent then return end
        if not isEnabled then return end
        if hum._lastAntiDeathTick and (now - hum._lastAntiDeathTick) < 0.1 then
            return
        end
        hum._lastAntiDeathTick = now

        pcall(function()
            if hum.Health < hum.MaxHealth then
                hum.Health = math.huge
            end
            if hum:GetStateEnabled(Enum.HumanoidStateType.Dead) then
                hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            end
        end)
    end))
end

local function RefreshControls(player, character)
    safe(function()
        local PlayerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
        local controls = PlayerModule:GetControls()
        if controls and controls.OnCharacterAdded then
            controls:OnCharacterAdded(character)
        end
    end)
end

local function SwapHumanoid(character)
    if not character then return end

    local oldHum = character:FindFirstChildOfClass("Humanoid")
    if not oldHum then
        local timeout = tick() + 5
        repeat
            task.wait(0.05)
            oldHum = character:FindFirstChildOfClass("Humanoid")
        until oldHum or tick() > timeout
    end
    if not oldHum then
        warn("[AntiDeath] Walang Humanoid na nahanap sa character.")
        return
    end

    local saved = SaveHumanoidProps(oldHum)

    local newHum
    safe(function() newHum = oldHum:Clone() end)
    if not newHum then
        warn("[AntiDeath] Hindi ma-clone ang Humanoid.")
        return
    end

    safe(function()
        for _, child in ipairs(oldHum:GetChildren()) do
            pcall(function() child.Parent = newHum end)
        end
    end)

    safe(function() oldHum:Destroy() end)

    safe(function() newHum.Parent = character end)

    RestoreHumanoidProps(newHum, saved)

    LockHealth(newHum)
    BlockDeathState(newHum)
    BindAntiDeath(newHum)

    StartBackgroundLoop(newHum)

    RefreshControls(LocalPlayer, character)

    safe(function()
        if Camera then
            Camera.CameraSubject = newHum
        end
    end)

    task.delay(0.25, function()
        if not isEnabled then return end
        safe(function()
            local h = character:FindFirstChildOfClass("Humanoid")
            if h then
                LockHealth(h)
                BlockDeathState(h)
                RestoreHumanoidProps(h, saved)
                if Camera then
                    Camera.CameraSubject = h
                end
            end
        end)
    end)

    return newHum
end

local function OnCharacterAdded(character)
    if not isEnabled then return end

    task.spawn(function()
        local hum = character:WaitForChild("Humanoid", 10)
        if not hum then return end
        task.wait(0.1)
        if isEnabled then
            SwapHumanoid(character)
        end
    end)
end

local CharacterAddedConn

local function Enable()
    isEnabled = true

    if CharacterAddedConn then
        pcall(function() CharacterAddedConn:Disconnect() end)
    end
    CharacterAddedConn = LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)

    task.spawn(function()
        local char = LocalPlayer.Character
        if char and isEnabled then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                task.wait(0.1)
                if isEnabled then
                    SwapHumanoid(char)
                end
            end
        end
    end)
end

local function Disable()
    isEnabled = false
    clearConnections()
    if CharacterAddedConn then
        pcall(function() CharacterAddedConn:Disconnect() end)
        CharacterAddedConn = nil
    end
end

Tabs.MiscTab:Toggle({
    Title = "Anti Death",
    Desc  = "Use only for Admin Egg Abuse and don't use Treadmill once this is Enabled or you'll stuck",
    Value = false,
    Callback = function(state)
        isEnabled = state
        if state then
            Enable()
        else
            Disable()
        end
    end,
})

local Players = game:GetService("Players")
local speaker = Players.LocalPlayer

Tabs.MiscTab:Slider({
    Title = "WalkSpeed",
    Desc = "Adjust your character's walking speed",
    IsTooltip = true,
    IsTextbox = true,
    Step = 1,
    Value = {
        Min = 0,
        Max = 1000,
        Default = 16,
    },
    Callback = function(value)
        pcall(function()
            local char = speaker.Character
            if char then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.WalkSpeed = value
                end
            end
        end)
    end,
})
