    local function updateList()
        for _, child in ipairs(scroll:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextLabel") then
                child:Destroy()
            end
        end

        local allEggs = {}
        if okState and eggState then
            local ok, result = pcall(eggState.ReadFieldEggs)
            if ok and type(result) == "table" and type(result.Records) == "table" then
                for _, record in pairs(result.Records) do
                    if type(record) == "table" and record.AssetCategory then
                        local petName = record.AssetCategory
                        local petInfo = assets and assets.Directory and assets.Directory[petName] or nil
                        local displayName = petInfo and (petInfo.DisplayName or petName) or petName
                        local scale = tonumber(record.AssetScale) or 1

                        local kg = 0
                        if okRecords and eggRecords and type(eggRecords.WeightKgForScale) == "function" then
                            local okKg, resKg = pcall(eggRecords.WeightKgForScale, petName, scale)
                            if okKg and tonumber(resKg) then kg = tonumber(resKg) end
                        end

                        if searchQuery == "" or string.find(string.lower(displayName), searchQuery, 1, true) then
                            table.insert(allEggs, {
                                Name         = displayName,
                                RarityName   = getRarityName(petInfo),
                                RarityColor  = getRarityColor(petInfo),
                                Scale        = scale,
                                Income       = getValue(petInfo, scale, record.Mutations),
                                Weight       = kg,
                                BottomCFrame = record.BottomCFrame,
                                Image        = getPetImage(petInfo),
                            })
                        end
                    end
                end
            end
        end

        table.sort(allEggs, function(a, b) return a.Income > b.Income end)

        if #allEggs == 0 then
            local empty = Instance.new("TextLabel")
