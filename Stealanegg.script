WindowAuraPage:Dropdown({Title="Aura Color",Values={"Green","Violet","Blood","Ice","Pink","White"},Default="Green",Callback=function(name) WIN_AURA.Color=AURA_COLORS[name] or WIN_AURA.Color end})
WindowAuraPage:Slider({Title="Intensity",Desc="How strong the glow is",Min=10,Max=100,Default=70,Callback=function(v) WIN_AURA.Intensity=v/100 end})

