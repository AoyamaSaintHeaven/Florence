local RunService = game:GetService("RunService")
local rotatingImages = {}
local ROTATION_SPEED = 45 -- degrees per second (lakasan/mahina)

RunService.Heartbeat:Connect(function(dt)
    for i = #rotatingImages, 1, -1 do
        local img = rotatingImages[i]
        if img and img.Parent then
            img.Rotation = (img.Rotation + ROTATION_SPEED * dt) % 360
        else
            table.remove(rotatingImages, i)
        end
    end
end)






