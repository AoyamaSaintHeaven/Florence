-- ============================================================
-- 🔑 CORE: Per-note timestamp builder
-- Bawat nota ay may SARILING time value → sariling tempo
-- ============================================================
local function buildNoteArray(sheet)
    local total_len = #sheet
    
    -- Tempo sections (batay sa posisyon sa sheet)
    -- Ito ang gumagawa ng AUTO TEMPO CHANGE
    local sections = {
        {end_pct = 0.15, unit = 0.55},   -- INTRO (mabagal, emosyonal)
        {end_pct = 0.35, unit = 0.42},   -- BUILDUP (katamtaman)
        {end_pct = 0.55, unit = 0.35},   -- MAIN (mas mabilis)
        {end_pct = 0.78, unit = 0.28},   -- CLIMAX (pinakamabilis)
        {end_pct = 0.92, unit = 0.30},   -- REPRISE (bumabalik)
        {end_pct = 1.00, unit = 0.48},   -- ENDING (mabagal ulit)
    }
    
    local events = {}
    local time = 0
    local i = 1
    local note_index = 0
    local section_i = 1
    local section = sections[1]
    
    while i <= total_len do
        -- Auto-switch ng tempo section
        local pct = i / total_len
        while section_i < #sections and pct > sections[section_i].end_pct do
            section_i = section_i + 1
            section = sections[section_i]
        end
        
        local c = sheet:sub(i, i)
        local keys = nil
        
        if c == "[" then
            local j = sheet:find("]", i)
            if not j then break end
            local chord = sheet:sub(i + 1, j - 1)
            keys = {}
            for k = 1, #chord do keys[#keys + 1] = chord:sub(k, k) end
            i = j + 1
        elseif c == "-" then
            -- Pause (advance time lang, walang nota)
            time = time + section.unit
            i = i + 1
        else
            keys = { c }
            i = i + 1
        end
        
        if keys then
            -- ✅ BAWAT NOTA may sariling timestamp `time`
            events[#events + 1] = { time = time, keys = keys }
            note_index = note_index + 1
            
            -- Subtle rubato (bawat nota may sariling variation)
            -- Resulta: hindi monotonous, natural ang feel
            local rubato = 1.0 + 0.06 * math.sin(note_index * 0.7)
                                  + 0.03 * math.cos(note_index * 1.3)
            
            time = time + section.unit * rubato
        end
    end
    
    return events
end

-- ============================================================
-- Key press simulation
-- ============================================================
local VirtualInputManager = game:GetService("VirtualInputManager")

local function pressKey(key)
    local keyCode = key:upper()
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- ============================================================
-- Play function (gumagamit ng per-note timestamps)
-- ============================================================
local isPlaying = false
local SpeedMultiplier = 1.0

local function playSong(songName)
    if isPlaying then return end
    local song = Songs[songName]
    if not song then
        OrionLib:MakeNotification({Name="Error", Content="Walang nota.", Time=3})
        return
    end

    isPlaying = true
    local events = buildNoteArray(song.sheet)
    local startTime = os.clock()
    
    print(("[Piano] Total notes: %d | Song duration: %.1f seconds"):format(
        #events, events[#events] and events[#events].time or 0
    ))

    task.spawn(function()
        for _, e in ipairs(events) do
            if not isPlaying then break end
            
            -- Awtomatikong hintayin ang tamang time ng note
            local targetTime = startTime + (e.time / SpeedMultiplier)
            local delay = targetTime - os.clock()
            if delay > 0 then task.wait(delay) end

            for _, key in ipairs(e.keys) do
                pressKey(key)
            end
        end
        
        isPlaying = false
        OrionLib:MakeNotification({
            Name = "Tapos na",
            Content = "Natapos: " .. songName,
            Time = 3
        })
    end)
end

