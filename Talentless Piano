-- 3. Parser: sheet + BPM -> timestamp array
local function parseSheet(sheet, bpm)
    local beat = 60 / bpm
    local events = {}
    local time = 0
    local i = 1
    while i <= #sheet do
        local c = sheet:sub(i, i)
        if c == "[" then
            local j = sheet:find("]", i)
            if not j then break end
            local chord = sheet:sub(i + 1, j - 1)
            local keys = {}
            for k = 1, #chord do keys[#keys + 1] = chord:sub(k, k) end
            events[#events + 1] = { time = time, keys = keys }
            time = time + beat
            i = j + 1
        elseif c == "-" then
            time = time + beat
            i = i + 1
        else
            events[#events + 1] = { time = time, keys = { c } }
            time = time + beat
            i = i + 1
        end
    end
    return events
end

-- 4. Key Press Simulation
local VirtualInputManager = game:GetService("VirtualInputManager")
local function pressKey(key)
    local keyCode = key:upper()
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- 5. Play Function (auto-tempo base sa timestamp)
local isPlaying = false
local TempoMultiplier = 1.0

local function playSong(songName)
    if isPlaying then return end
    local song = Songs[songName]
    if not song then
        OrionLib:MakeNotification({Name="Error", Content="Walang nota para sa kantang ito.", Time=3})
        return
    end

    isPlaying = true
    local events = parseSheet(song.sheet, song.bpm)
    local startTime = os.clock()

    task.spawn(function()
        for _, e in ipairs(events) do
            if not isPlaying then break end
            local targetTime = startTime + (e.time / TempoMultiplier)
            local delay = targetTime - os.clock()
            if delay > 0 then task.wait(delay) end

            for _, key in ipairs(e.keys) do
                pressKey(key)
            end
        end
        isPlaying = false
        OrionLib:MakeNotification({
            Name = "Tapos na",
            Content = "Natapos: " .. songName,
            Time = 3
        })
    end)
end

